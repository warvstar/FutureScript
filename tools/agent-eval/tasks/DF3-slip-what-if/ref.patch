+
+// What if task id slipped by days more? "<id>: day <old> -> day <new>" for each
+// task whose finish moves, in topological order. The project is left as it was.
+fn whatIf(p: Project, id: str, days: num): list<str> {
+  var t = taskOf(p, id)
+  var before = earliest(p)
+  t.lagDays += days
+  var after = earliest(p)
+  t.lagDays -= days
+  var out = []
+  for tid in topoOrder(p) {
+    if before[tid].finish != after[tid].finish {
+      out.push("{tid}: day {before[tid].finish} -> day {after[tid].finish}")
+    }
+  }
+  return out
+}
+
+test "lag" {
+  var p = demoProject()
+  p.find("frontend").lagDays = 2
+  expect earliest(p)["frontend"] == {start: 5, finish: 9}
+  expect criticalPath(p) == ["design", "frontend", "integrate", "release"]
+  expect formatTask(p.find("frontend")) == "[ ] frontend    Build pages (4 days, unassigned, waits 2 days)"
+}
+
+test "what if a task slips" {
+  var p = demoProject()
+  expect whatIf(p, "docs", 3) == ["docs: day 4 -> day 7"]
+  expect whatIf(p, "frontend", 3) == ["frontend: day 7 -> day 10", "integrate: day 10 -> day 12", "release: day 11 -> day 13"]
+  expect p.find("frontend").lagDays == 0
+  expect throws { whatIf(p, "qa", 1) } == "no task qa in Website"
+}
