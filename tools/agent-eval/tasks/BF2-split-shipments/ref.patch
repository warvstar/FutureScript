+// A warehouse and how many units of each SKU it holds.
+class Warehouse {
+  var name: str
+  var stock: map<str, num> = {}
+  fn init(name: str) { self.name = name }
+  fn put(sku: str, qty: num): Warehouse {
+    if qty <= 0 { throw "put needs a positive quantity" }
+    self.stock[sku] = self.stockOf(sku) + qty
+    return self
+  }
+  fn stockOf(sku: str): num {
+    var n = self.stock[sku]
+    return n == nil ? 0 : n
+  }
+}
+
+// What one warehouse sends: units per SKU, the parcel's weight and its shipping.
+class Shipment {
+  var warehouse: str
+  var units: map<str, num> = {}
+  var grams: num = 0
+  var cost: num = 0
+  fn init(warehouse: str) { self.warehouse = warehouse }
+}
+
+// Split a cart across warehouses, taking each line from the first warehouses that have it.
+// Takes the units out of the warehouses; all or nothing.
+fn splitShipments(cart: Cart, warehouses: list<Warehouse>, region: str): list<Shipment> {
+  var parts = []
+  for w in warehouses { parts.push(Shipment(w.name)) }
+  atomic {
+    for l in cart.lines {
+      var left = l.qty
+      for i in 0..warehouses.len() {
+        var w = warehouses[i]
+        var take = w.stockOf(l.sku)
+        if take > left { take = left }
+        if take > 0 {
+          w.stock[l.sku] = w.stockOf(l.sku) - take
+          var s = parts[i]
+          s.units[l.sku] = take
+          s.grams += take * l.weightGrams
+          left -= take
+        }
+      }
+      if left > 0 { throw "the warehouses are {left} short of {l.sku}" }
+    }
+  }
+  var out = []
+  for s in parts {
+    if s.units.len() > 0 {
+      s.cost = shippingCents(s.grams, region)
+      out.push(s)
+    }
+  }
+  return out
+}
+
+fn shipmentsCost(shipments: list<Shipment>): num {
+  var t = 0
+  for s in shipments { t += s.cost }
+  return t
+}
+
+// "East: TEE-S x2, MUG-BLU x1 (710 g, $8.99)"
+fn describeShipment(s: Shipment): str {
+  var items = []
+  for sku in s.units { items.push("{sku} x{s.units[sku]}") }
+  return "{s.warehouse}: {items.join(", ")} ({formatKg(s.grams)}, {formatMoney(s.cost)})"
+}
