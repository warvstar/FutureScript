+
+test "split shipments" {
+  var cat = sampleCatalog()
+  var east = Warehouse("East").put("TEE-S", 1).put("LAMP", 1)
+  var west = Warehouse("West").put("MUG-BLU", 4)
+  var north = Warehouse("North").put("TEE-S", 5).put("MUG-BLU", 2)
+  var cart = cartOf(cat, [["TEE-S", 3], ["MUG-BLU", 1], ["LAMP", 1]])
+  var parts = splitShipments(cart, [east, west, north], "CA")
+  expect parts.len() == 3
+  expect describeShipment(parts[0]) == "East: TEE-S x1, LAMP x1 (1.78 kg, $8.99)"
+  expect describeShipment(parts[1]) == "West: MUG-BLU x1 (350 g, $4.99)"
+  expect describeShipment(parts[2]) == "North: TEE-S x2 (360 g, $4.99)"
+  expect shipmentsCost(parts) == 899 + 499 + 499
+  expect east.stockOf("TEE-S") == 0
+  expect north.stockOf("TEE-S") == 3
+  expect north.stockOf("MUG-BLU") == 2
+  expect splitShipments(Cart(), [east], "CA") == []
+}
+
+test "split shipments are all or nothing" {
+  var cat = sampleCatalog()
+  var east = Warehouse("East").put("MUG-BLU", 2)
+  var west = Warehouse("West").put("LAMP", 1)
+  var cart = cartOf(cat, [["MUG-BLU", 2], ["LAMP", 2]])
+  expect throws { splitShipments(cart, [east, west], "NY") }
+  expect east.stockOf("MUG-BLU") == 2
+  expect west.stockOf("LAMP") == 1
+  expect west.stockOf("TEE-S") == 0
 }
