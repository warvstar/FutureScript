 pub class Person {
   var name: str
   var capacityPerWeek: num   // days of work they can take on per week
+  var daysOff: map = {}      // day number -> true for each day they're away
   fn init(name: str, capacityPerWeek: num) {
     self.name = name
     self.capacityPerWeek = capacityPerWeek
+  }
+  // Away for days days, starting on day first (day 0 is the project's first day).
+  fn takeOff(first: num, days: num) {
+    if first < 0 || first != floor(first) || days < 1 || days != floor(days) {
+      throw "{self.name}: bad time off"
+    }
+    for d in first..first + days { self.daysOff[d] = true }
+  }
+  fn isAway(day: num): bool {
+    return self.daysOff.has(day)
   }
 }
 
