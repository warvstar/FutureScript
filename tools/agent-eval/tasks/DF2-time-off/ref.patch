+// Like earliest, but a task's work only happens on days its assignee isn't away:
+// it starts on the first such day once its deps have finished, and finishes
+// the day after its last day of work.
+pub fn earliestWithLeave(p: Project): map ! {
+  var out = {}
+  for id in topoOrder(p) {
+    var t = taskOf(p, id)
+    var ready = 0
+    for d in t.deps {
+      if out.has(d) { ready = math.max(ready, out[d].finish) }
+    }
+    var who = t.assignee == nil ? nil : p.person(t.assignee)
+    if who == nil || t.durationDays == 0 {
+      out[id] = {start: ready, finish: ready + t.durationDays}
+      continue
+    }
+    var day = ready
+    while who.isAway(day) { day += 1 }
+    var start = day
+    var left = t.durationDays
+    while left > 0 {
+      if !who.isAway(day) { left -= 1 }
+      day += 1
+    }
+    out[id] = {start: start, finish: day}
+  }
+  return out
+}
