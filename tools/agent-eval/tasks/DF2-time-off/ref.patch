+
+// How many days longer the project runs end to end because of time off.
+fn leaveDelay(p: Project): num {
+  var end = 0
+  for span in earliestWithLeave(p).values() { end = math.max(end, span.finish) }
+  return end - projectLength(p)
+}
+
+test "time off" {
+  var p = demoProject()
+  var bo = p.person("bo")
+  bo.takeOff(4, 2)
+  expect bo.isAway(4) && bo.isAway(5) && !bo.isAway(6)
+  expect throws { bo.takeOff(1.5, 2) } == "bo: bad time off"
+  expect throws { bo.takeOff(3, 0) } == "bo: bad time off"
+  expect leaveDelay(p) == 0
+  assign(p, "backend", "bo")
+  var spans = earliestWithLeave(p)
+  expect spans["backend"] == {start: 3, finish: 10}
+  expect spans["release"] == {start: 12, finish: 13}
+  expect leaveDelay(p) == 2
 }
