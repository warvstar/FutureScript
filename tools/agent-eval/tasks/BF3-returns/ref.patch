+
+test "returns" {
+  var cat = sampleCatalog()
+  var cart = cartOf(cat, [["TEE-S", 3], ["MUG-BLU", 2]])
+  var inv = checkout(cat, cart, 10, "CA")
+  expect findVariant(cat, "TEE-S").stock == 9
+  var note = returnItems(cat, inv, [["TEE-S", 2], ["MUG-BLU", 1]], 501)
+  expect note.invoice == 10
+  expect note.lines.len() == 2
+  expect note.lines[0].label == "Organic tee, S"
+  expect note.lines[0].cents == 3600
+  expect note.goods == 4800
+  expect note.tax == 348
+  expect note.total == 5148
+  expect findVariant(cat, "TEE-S").stock == 11
+  expect findVariant(cat, "MUG-BLU").stock == 7
+  expect inv.credits.len() == 1
+  expect inv.lines[0].returned == 2
+}
+
+test "returns keep the discount and are all or nothing" {
+  var cat = sampleCatalog()
+  var cart = cartOf(cat, [["TEE-M", 2], ["LAMP", 1]])
+  cart.code = "SPRING25"
+  var inv = checkout(cat, cart, 11, "NY")
+  var note = returnItems(cat, inv, [["TEE-M", 1]], 502)
+  expect note.goods == 1800
+  expect note.tax == 54
+  expect note.total == 1350 + 54
+  expect throws { returnItems(cat, inv, [["LAMP", 1], ["TEE-M", 2]], 503) }
+  expect throws { returnItems(cat, inv, [["MUG-BLU", 1]], 503) }
+  expect findVariant(cat, "LAMP").stock == 1
+  expect inv.lines[1].returned == 0
+  expect inv.credits.len() == 1
+}
