+// Money given back for returned goods: one line per returned SKU, at the price paid before any discount.
+pub class CreditNote {
+  var number: num
+  var invoice: num
+  var lines: list<InvoiceLine> = []
+  var goods: num = 0
+  var tax: num = 0
+  var total: num = 0
+  fn init(number: num, invoice: num) {
+    self.number = number
+    self.invoice = invoice
+  }
+}
+
 // Tax is charged on the discounted subtotal; shipping is not taxed.
 // An unknown discount code is ignored.
 pub fn buildInvoice(number: num, cart: Cart, region: str): Invoice ! {
   var inv = Invoice(number, region)
   for l in cart.lines {
-    inv.lines.push(InvoiceLine(l.name, l.qty, l.totalCents()))
+    var line = InvoiceLine(l.name, l.qty, l.totalCents())
+    line.sku = l.sku
+    inv.lines.push(line)
   }
   inv.subtotal = subtotalCents(cart)
   inv.shipping = shippingCents(cartGrams(cart), region)
@@ -45,6 +65,39 @@
   inv.tax = taxCents(inv.subtotal - inv.discount, region)
   inv.total = inv.subtotal - inv.discount + inv.shipping + inv.tax
   return inv
+}
+
+// Take back [sku, qty] pairs from an invoice: put them back on the shelf and record a credit note on it.
+// The refund keeps the invoice's discount share and refunds the tax on the rest; shipping is not refunded.
+// All or nothing: throws, changing nothing, on an unknown SKU or more units than are left to return.
+pub fn returnItems(cat: Catalog, inv: Invoice, items: list, number: num): CreditNote ! {
+  var note = CreditNote(number, inv.number)
+  atomic {
+    for it in items {
+      var sku = it[0]
+      var qty = it[1]
+      if qty <= 0 { throw "return quantity must be positive" }
+      var line = nil
+      for l in inv.lines {
+        if l.sku == sku { line = l }
+      }
+      if line == nil { throw "{sku} is not on invoice #{inv.number}" }
+      if qty > line.qty - line.returned { throw "only {line.qty - line.returned} of {sku} left to return" }
+      var v = findVariant(cat, sku)
+      if v == nil { throw "{sku} is no longer sold" }
+      restock(v, qty)
+      line.returned += qty
+      var cents = line.cents / line.qty * qty
+      note.lines.push(InvoiceLine(line.label, qty, cents))
+      note.goods += cents
+    }
+    var paid = inv.subtotal == 0 ? 0 : note.goods * (inv.subtotal - inv.discount) / inv.subtotal
+    var refund = floor(paid + 0.5)
+    note.tax = taxCents(refund, inv.region)
+    note.total = refund + note.tax
+    inv.credits.push(note)
+  }
+  return note
 }
 
