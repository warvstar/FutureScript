+// The head of a page: a <title> line (the document's title, or "Untitled"), then a <meta> line for each front matter key
+// but title, in order.
+pub fn renderHead(doc: Doc): str {
+  var out = ["<title>" + escape(doc.title == "" ? "Untitled" : doc.title) + "</title>"]
+  for k in doc.meta.keys() {
+    if k != "title" { out.push("<meta name=\"" + escape(k) + "\" content=\"" + escape(doc.meta[k]) + "\">") }
+  }
+  return out.join("\n")
