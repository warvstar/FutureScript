+// The key: value pairs of front matter lines. Keys are lower case; a value loses one pair of surrounding double quotes.
+fn frontMatter(lines: list): map {
+  var meta = {}
+  for l in lines {
+    var colon = l.raw.find(":")
+    if colon < 0 { continue }
+    var key = strings.lower(l.raw.slice(0, colon).trim())
+    if key == "" { continue }
+    var value = l.raw[colon + 1:].trim()
+    if value.len() >= 2 && strings.startsWith(value, "\"") && strings.endsWith(value, "\"") { value = value.slice(1, value.len() - 1) }
+    meta[key] = value
+  }
+  return meta
+}
