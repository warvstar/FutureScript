+// Pay as much of what's still due as the card's balance covers. Returns the cents taken off the card.
+pub fn applyGiftCard(inv: Invoice, card: GiftCard): num ! {
+  var paid = card.redeem(inv.due)
+  inv.giftCards += paid
+  inv.due -= paid
+  return paid
+}
