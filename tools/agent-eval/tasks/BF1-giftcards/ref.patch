+// Pay an invoice with gift cards, in order, until nothing is due.
+// Returns the codes of the cards that paid something.
+fn payWithCards(inv: Invoice, cards: list<GiftCard>): list<str> {
+  var used = []
+  for c in cards {
+    if applyGiftCard(inv, c) > 0 { used.push(c.code) }
+  }
+  return used
+}
