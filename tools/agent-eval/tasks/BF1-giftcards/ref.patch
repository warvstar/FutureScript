+// A prepaid gift card. Its balance is in cents and never goes below zero.
+pub class GiftCard {
+  var code: str
+  var balance: num
+  fn init(code: str, balance: num) {
+    if balance < 0 { throw "a gift card can't have a negative balance" }
+    self.code = code
+    self.balance = balance
+  }
+  // Take up to cents off the balance and return how much was taken.
+  fn redeem(cents: num): num {
+    if cents < 0 { throw "can't redeem a negative amount" }
+    var taken = cents < self.balance ? cents : self.balance
+    self.balance -= taken
+    return taken
+  }
+}
