+
+// Percent of the project's days that are done, rounded.
+fn percentDone(p: Project): num {
+  var total = 0
+  var done = 0
+  for t in p.tasks {
+    total += t.durationDays
+    if t.done { done += t.durationDays }
+  }
+  if total == 0 { return 0 }
+  return math.round(done / total * 100)
+}
+
+test "percent done" {
+  var p = demoProject()
+  expect percentDone(p) == 0
+  markDone(p, "design")
+  markDone(p, "docs")
+  expect percentDone(p) == 25
+  expect percentDone(Project("Empty")) == 0
 }
