+fn sameKind(a: Status, b: Status): bool ! {
+  match a {
+    Poison(_, _) { match b { Status.Poison(_, _) { return true } else { return false } } }
+    Stun(_) { match b { Status.Stun(_) { return true } else { return false } } }
+  }
+}
+
+// Puts s on c, replacing one of the same kind in place, else at the end.
+pub fn addStatus(c: any, s: Status) ! {
+  for i in 0..c.statuses.len() {
+    if sameKind(c.statuses[i], s) {
+      c.statuses[i] = s
+      return
+    }
+  }
+  c.statuses.push(s)
+}
+
+// The start of c's turn: poison hurts, stun holds it, then each status loses a turn.
+// Returns {log, canAct}.
+pub fn tickStatuses(c: any): map ! {
+  var log = []
+  var stunned = false
+  var left = []
+  for s in c.statuses {
+    match s {
+      Poison(damage, turns) {
+        log.push("{c.name} takes {applyDamage(c, damage)} poison damage")
+        if turns > 1 { left.push(Status.Poison(damage, turns - 1)) }
+      }
+      Stun(turns) {
+        log.push("{c.name} is stunned")
+        stunned = true
+        if turns > 1 { left.push(Status.Stun(turns - 1)) }
+      }
+    }
+  }
+  c.statuses = left
+  return {log: log, canAct: !stunned && isAlive(c)}
+}
