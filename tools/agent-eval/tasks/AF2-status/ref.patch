+
+test "statuses" {
+  var m = makeMonster("slime", 1)
+  addStatus(m, Status.Poison(3, 2))
+  addStatus(m, Status.Stun(1))
+  addStatus(m, Status.Poison(2, 2))
+  expect m.statuses == [Status.Poison(2, 2), Status.Stun(1)]
+  expect tickStatuses(m) == {log: ["slime takes 2 poison damage", "slime is stunned"], canAct: false}
+  expect m.hp == 6
+  expect m.statuses == [Status.Poison(2, 1)]
+  expect tickStatuses(m) == {log: ["slime takes 2 poison damage"], canAct: true}
+  expect tickStatuses(m) == {log: [], canAct: true}
 }
