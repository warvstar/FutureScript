+pub fn isLabel(s: str): bool ! {
+  if s == "" { return false }
+  for c in s {
+    if !((c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "-" || c == "_") { return false }
+  }
+  return true
