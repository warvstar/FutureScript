+// A line per milestone, in the order they were added:
+// "beta: day 10, 1/3 done", or "beta: reached" once all its tasks are done.
+pub fn milestoneReport(p: Project): str ! {
+  var lines = []
+  for m in p.milestones {
+    var done = 0
+    for id in m.taskIds { if taskOf(p, id).done { done += 1 } }
+    if done == m.taskIds.len() {
+      lines.push("{m.name}: reached")
+    } else {
+      lines.push("{m.name}: day {milestoneDay(p, m)}, {done}/{m.taskIds.len()} done")
+    }
+  }
+  return lines.join("\n")
+}
+
 pub fn printReport(p: Project) ! io {
   print(summary(p))
   print("critical path: {criticalPath(p).join(" > ")}")
   print(statusTable(p))
+  if p.milestones.len() > 0 { print(milestoneReport(p)) }
 }
 
