+// A block quote from consecutive quote lines: a line with no text after ">" ends a paragraph; empty ones are dropped.
+fn quote(lines: list): Node {
+  var paras = []
+  var para = []
+  for l in lines {
+    if l.text != "" { para.push(l) continue }
+    if para.len() > 0 { paras.push(paragraph(para)) para = [] }
+  }
+  if para.len() > 0 { paras.push(paragraph(para)) }
+  return Node.Quote(paras)
