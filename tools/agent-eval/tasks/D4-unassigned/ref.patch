+
+// Ids of unfinished tasks nobody has been given, in project order.
+fn unassigned(p: Project): list<str> {
+  var out = []
+  for t in p.tasks {
+    if !t.done && t.assignee == nil { out.push(t.id) }
+  }
+  return out
+}
+
+test "unassigned" {
+  var p = demoProject()
+  assign(p, "backend", "bo")
+  markDone(p, "design")
+  expect unassigned(p) == ["frontend", "integrate", "docs", "release"]
+}
