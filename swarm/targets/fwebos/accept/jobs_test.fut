// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/os.fut"

fn acceptSh(os, line) {
  var r = sh(os, line)
  return [r.out, r.err, r.code]
}

fn acceptSyntax(os, line) {
  var r = sh(os, line)
  return r.code == 2 && r.out == "" && r.err.find("sh: syntax error: ") == 0
}

fn acceptTick(os, ms) {
  var r = tick(os, ms)
  return [r.out, r.err]
}

fn acceptWins(os) {
  var r = []
  for w in wmList(os) { r.push([w.id, w.app, w.title, w.x, w.y, w.w, w.h, w.focused, w.minimized, w.maximized]) }
  return r
}

fn acceptCursor(os, t) {
  var c = termCursor(os, t)
  return [c.row, c.col]
}

test "a background job runs at the end of the line" {
  var os = boot()
  expect acceptSh(os, "echo hi &") == ["[1] 2\nhi\n[1] Done\techo hi\n", "", 0]
  expect acceptSh(os, "echo a & echo b") == ["[2] 3\nb\na\n[2] Done\techo a\n", "", 0]
  expect acceptSh(os, "echo a & sleep 1; echo b") == ["[3] 4\na\n[3] Done\techo a\nb\n", "", 0]
  expect acceptSh(os, "  echo x   &") == ["[4] 5\nx\n[4] Done\techo x\n", "", 0]
  expect acceptSh(os, "echo p & echo q &") == ["[5] 6\n[6] 7\np\n[5] Done\techo p\nq\n[6] Done\techo q\n", "", 0]
}

test "sleeping jobs wake as the clock moves" {
  var os = boot()
  expect acceptSh(os, "sleep 2 && echo done &") == ["[1] 2\n", "", 0]
  expect acceptTick(os, 1000) == ["", ""]
  expect acceptTick(os, 999) == ["", ""]
  expect acceptTick(os, 1) == ["done\n[1] Done\tsleep 2 && echo done\n", ""]
  expect acceptTick(os, 5000) == ["", ""]
  expect acceptSh(os, "uptime") == ["up 7.000s\n", "", 0]
}

test "jobs and ps" {
  var os = boot()
  expect acceptSh(os, "sleep 5 &") == ["[1] 2\n", "", 0]
  expect acceptSh(os, "sleep 3 && echo late &") == ["[2] 3\n", "", 0]
  expect acceptSh(os, "jobs") == ["[1] Running\tsleep 5\n[2] Running\tsleep 3 && echo late\n", "", 0]
  expect acceptSh(os, "ps") == ["PID\tSTAT\tCMD\n1\tR\tsh\n2\tS\tsleep 5\n3\tS\tsleep 3 && echo late\n", "", 0]
  expect acceptSh(os, "sleep 1 & ps") == ["[3] 4\nPID\tSTAT\tCMD\n1\tR\tsh\n2\tS\tsleep 5\n3\tS\tsleep 3 && echo late\n4\tR\tsleep 1\n", "", 0]
  expect acceptSh(os, "jobs") == ["[1] Running\tsleep 5\n[2] Running\tsleep 3 && echo late\n[3] Running\tsleep 1\n", "", 0]
  expect acceptTick(os, 1000) == ["[3] Done\tsleep 1\n", ""]
  expect acceptSh(os, "jobs") == ["[1] Running\tsleep 5\n[2] Running\tsleep 3 && echo late\n", "", 0]
  expect acceptSh(os, "ps") == ["PID\tSTAT\tCMD\n1\tR\tsh\n2\tS\tsleep 5\n3\tS\tsleep 3 && echo late\n", "", 0]
}

test "jobs interleave in time" {
  var os = boot()
  expect acceptSh(os, "for i in 1 2 3; do echo a$i; sleep 1; done &") == ["[1] 2\na1\n", "", 0]
  expect acceptSh(os, "for i in 1 2 3; do echo b$i; sleep 1; done &") == ["[2] 3\nb1\n", "", 0]
  expect acceptSh(os, "sleep 5") == ["a2\nb2\na3\nb3\n[1] Done\tfor i in 1 2 3; do echo a$i; sleep 1; done\n[2] Done\tfor i in 1 2 3; do echo b$i; sleep 1; done\n", "", 0]
  expect acceptSh(os, "uptime") == ["up 5.000s\n", "", 0]
}

test "a job's exit status" {
  var os = boot()
  expect acceptSh(os, "false &") == ["[1] 2\n[1] Exit 1\tfalse\n", "", 0]
  expect acceptSh(os, "nope &") == ["[2] 3\n[2] Exit 127\tnope\n", "sh: nope: command not found\n", 0]
  expect acceptSh(os, "test 1 -gt 2 &") == ["[3] 4\n[3] Exit 1\ttest 1 -gt 2\n", "", 0]
  expect acceptSh(os, "true && false || true &") == ["[4] 5\n[4] Done\ttrue && false || true\n", "", 0]
}

test "kill" {
  var os = boot()
  expect acceptSh(os, "while true; do echo tick; sleep 1; done &") == ["[1] 2\ntick\n", "", 0]
  expect acceptTick(os, 2500) == ["tick\ntick\n", ""]
  expect acceptSh(os, "kill %1") == ["[1] Terminated\twhile true; do echo tick; sleep 1; done\n", "", 0]
  expect acceptSh(os, "kill %1") == ["", "kill: %1: No such process\n", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "sleep 10 &") == ["[2] 3\n", "", 0]
  expect acceptSh(os, "sleep 10 &") == ["[3] 4\n", "", 0]
  expect acceptSh(os, "kill 4") == ["[3] Terminated\tsleep 10\n", "", 0]
  expect acceptSh(os, "jobs") == ["[2] Running\tsleep 10\n", "", 0]
  expect acceptSh(os, "kill 99 3") == ["[2] Terminated\tsleep 10\n", "kill: 99: No such process\n", 1]
  expect acceptSh(os, "jobs") == ["", "", 0]
}

test "wait" {
  var os = boot()
  expect acceptSh(os, "sleep 2 && echo a &") == ["[1] 2\n", "", 0]
  expect acceptSh(os, "sleep 1 && echo b &") == ["[2] 3\n", "", 0]
  expect acceptSh(os, "wait") == ["b\n[2] Done\tsleep 1 && echo b\na\n[1] Done\tsleep 2 && echo a\n", "", 0]
  expect acceptSh(os, "uptime") == ["up 2.000s\n", "", 0]
  expect acceptSh(os, "sleep 3 && echo c &") == ["[3] 4\n", "", 0]
  expect acceptSh(os, "sleep 1 && echo d &") == ["[4] 5\n", "", 0]
  expect acceptSh(os, "wait %4") == ["d\n[4] Done\tsleep 1 && echo d\n", "", 0]
  expect acceptSh(os, "jobs") == ["[3] Running\tsleep 3 && echo c\n", "", 0]
  expect acceptSh(os, "wait 5") == ["", "", 0]
  expect acceptSh(os, "wait") == ["c\n[3] Done\tsleep 3 && echo c\n", "", 0]
  expect acceptSh(os, "uptime") == ["up 5.000s\n", "", 0]
  expect acceptSh(os, "wait %9") == ["", "", 0]
}

test "sleep and uptime" {
  var os = boot()
  expect acceptSh(os, "uptime") == ["up 0.000s\n", "", 0]
  expect acceptSh(os, "sleep 1.5") == ["", "", 0]
  expect acceptSh(os, "uptime") == ["up 1.500s\n", "", 0]
  expect acceptSh(os, "sleep 0.25") == ["", "", 0]
  expect acceptSh(os, "uptime") == ["up 1.750s\n", "", 0]
  expect acceptTick(os, 250) == ["", ""]
  expect acceptSh(os, "uptime") == ["up 2.000s\n", "", 0]
  expect acceptSh(os, "sleep 0") == ["", "", 0]
  expect acceptSh(os, "uptime") == ["up 2.000s\n", "", 0]
}

test "a job has its own copy of the session" {
  var os = boot()
  expect acceptSh(os, "X=1") == ["", "", 0]
  expect acceptSh(os, "X=2 && cd /tmp && echo $X $PWD &") == ["[1] 2\n2 /tmp\n[1] Done\tX=2 && cd /tmp && echo $X $PWD\n", "", 0]
  expect acceptSh(os, "echo $X $PWD") == ["1 /home/user\n", "", 0]
  expect acceptSh(os, "Y=$(echo sub) && echo $Y &") == ["[2] 3\nsub\n[2] Done\tY=$(echo sub) && echo $Y\n", "", 0]
  expect acceptSh(os, "echo [$Y]") == ["[]\n", "", 0]
}

test "job numbers are never reused" {
  var os = boot()
  expect acceptSh(os, "echo a &") == ["[1] 2\na\n[1] Done\techo a\n", "", 0]
  expect acceptSh(os, "echo b &") == ["[2] 3\nb\n[2] Done\techo b\n", "", 0]
  expect acceptSh(os, "sleep 1 &") == ["[3] 4\n", "", 0]
  expect acceptSh(os, "jobs") == ["[3] Running\tsleep 1\n", "", 0]
  expect acceptSh(os, "wait") == ["[3] Done\tsleep 1\n", "", 0]
  expect acceptSh(os, "echo c &") == ["[4] 5\nc\n[4] Done\techo c\n", "", 0]
}

test "jobs write files" {
  var os = boot()
  expect acceptSh(os, "for i in 1 2 3; do echo $i >> log; sleep 1; done &") == ["[1] 2\n", "", 0]
  expect acceptSh(os, "cat log") == ["1\n", "", 0]
  expect acceptTick(os, 1000) == ["", ""]
  expect acceptSh(os, "cat log") == ["1\n2\n", "", 0]
  expect acceptSh(os, "wait") == ["[1] Done\tfor i in 1 2 3; do echo $i >> log; sleep 1; done\n", "", 0]
  expect acceptSh(os, "cat log") == ["1\n2\n3\n", "", 0]
}
