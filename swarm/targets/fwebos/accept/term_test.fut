// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/os.fut"

fn acceptSh(os, line) {
  var r = sh(os, line)
  return [r.out, r.err, r.code]
}

fn acceptSyntax(os, line) {
  var r = sh(os, line)
  return r.code == 2 && r.out == "" && r.err.find("sh: syntax error: ") == 0
}

fn acceptTick(os, ms) {
  var r = tick(os, ms)
  return [r.out, r.err]
}

fn acceptWins(os) {
  var r = []
  for w in wmList(os) { r.push([w.id, w.app, w.title, w.x, w.y, w.w, w.h, w.focused, w.minimized, w.maximized]) }
  return r
}

fn acceptCursor(os, t) {
  var c = termCursor(os, t)
  return [c.row, c.col]
}

test "a new terminal shows a prompt" {
  var os = boot()
  var t0 = termNew(os, 30, 3)
  expect t0 == 1
  expect termScreen(os, t0) == ["user@fwebos:~$                ", "                              ", "                              "]
  expect acceptCursor(os, t0) == [0, 15]
}

test "typing and running a command" {
  var os = boot()
  var t0 = termNew(os, 30, 5)
  expect t0 == 1
  termType(os, t0, "echo hi")
  expect termScreen(os, t0) == ["user@fwebos:~$ echo hi        ", "                              ", "                              ", "                              ", "                              "]
  expect acceptCursor(os, t0) == [0, 22]
  termType(os, t0, "\n")
  expect termScreen(os, t0) == ["user@fwebos:~$ echo hi        ", "hi                            ", "user@fwebos:~$                ", "                              ", "                              "]
  expect acceptCursor(os, t0) == [2, 15]
  termType(os, t0, "ls /\n")
  expect termScreen(os, t0) == ["hi                            ", "user@fwebos:~$ ls /           ", "home                          ", "tmp                           ", "user@fwebos:~$                "]
  expect acceptCursor(os, t0) == [4, 15]
}

test "the prompt shows the directory" {
  var os = boot()
  var t0 = termNew(os, 40, 4)
  expect t0 == 1
  termType(os, t0, "cd /tmp\n")
  termType(os, t0, "mkdir -p ~/docs/a; cd ~/docs/a\n")
  expect termScreen(os, t0) == ["user@fwebos:~$ cd /tmp                  ", "user@fwebos:/tmp$ mkdir -p ~/docs/a; cd ", "~/docs/a                                ", "user@fwebos:~/docs/a$                   "]
  expect acceptCursor(os, t0) == [3, 22]
}

test "line editing" {
  var os = boot()
  var t0 = termNew(os, 40, 3)
  expect t0 == 1
  termType(os, t0, "eco hi")
  termKeys(os, t0, ["Home", "Right", "Right", "c", "End", "!"])
  expect termScreen(os, t0) == ["user@fwebos:~$ ecco hi!                 ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [0, 23]
  termKeys(os, t0, ["Left", "Backspace", "Left", "Delete"])
  expect termScreen(os, t0) == ["user@fwebos:~$ ecco !                   ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [0, 20]
  termKeys(os, t0, ["Home", "Delete", "e", "Enter"])
  expect termScreen(os, t0) == ["user@fwebos:~$ ecco !                   ", "sh: ecco: command not found             ", "user@fwebos:~$                          "]
  expect acceptCursor(os, t0) == [2, 15]
}

test "cursor keys stop at the ends" {
  var os = boot()
  var t0 = termNew(os, 30, 2)
  expect t0 == 1
  termType(os, t0, "ab")
  termKeys(os, t0, ["Left", "Left", "Left", "Backspace", "x", "Right", "Right", "Right", "y"])
  expect termScreen(os, t0) == ["user@fwebos:~$ xaby           ", "                              "]
  expect acceptCursor(os, t0) == [0, 19]
}

test "long lines wrap" {
  var os = boot()
  var t0 = termNew(os, 20, 6)
  expect t0 == 1
  termType(os, t0, "echo 0123456789abcdefghijklmnop\n")
  expect termScreen(os, t0) == ["user@fwebos:~$ echo ", "0123456789abcdefghij", "klmnop              ", "0123456789abcdefghij", "klmnop              ", "user@fwebos:~$      "]
  expect acceptCursor(os, t0) == [5, 15]
  termType(os, t0, "abcde")
  expect termScreen(os, t0) == ["0123456789abcdefghij", "klmnop              ", "0123456789abcdefghij", "klmnop              ", "user@fwebos:~$ abcde", "                    "]
  expect acceptCursor(os, t0) == [5, 0]
}

test "the cursor wraps at the edge" {
  var os = boot()
  var t0 = termNew(os, 20, 4)
  expect t0 == 1
  termType(os, t0, "echo")
  expect termScreen(os, t0) == ["user@fwebos:~$ echo ", "                    ", "                    ", "                    "]
  expect acceptCursor(os, t0) == [0, 19]
  termType(os, t0, " ")
  expect termScreen(os, t0) == ["user@fwebos:~$ echo ", "                    ", "                    ", "                    "]
  expect acceptCursor(os, t0) == [1, 0]
  termType(os, t0, "1")
  expect termScreen(os, t0) == ["user@fwebos:~$ echo ", "1                   ", "                    ", "                    "]
  expect acceptCursor(os, t0) == [1, 1]
  termKeys(os, t0, ["Left"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo ", "1                   ", "                    ", "                    "]
  expect acceptCursor(os, t0) == [1, 0]
}

test "the screen scrolls" {
  var os = boot()
  var t0 = termNew(os, 20, 4)
  expect t0 == 1
  termType(os, t0, "seq 10\n")
  expect termScreen(os, t0) == ["8                   ", "9                   ", "10                  ", "user@fwebos:~$      "]
  expect acceptCursor(os, t0) == [3, 15]
}

test "errors go to the screen" {
  var os = boot()
  var t0 = termNew(os, 40, 4)
  expect t0 == 1
  termType(os, t0, "nope\ncat missing\n")
  expect termScreen(os, t0) == ["sh: nope: command not found             ", "user@fwebos:~$ cat missing              ", "cat: missing: No such file or directory ", "user@fwebos:~$                          "]
  expect acceptCursor(os, t0) == [3, 15]
}

test "history" {
  var os = boot()
  var t0 = termNew(os, 30, 3)
  expect t0 == 1
  termType(os, t0, "echo a\necho b\n")
  termType(os, t0, "draft")
  termKeys(os, t0, ["Up"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo b         ", "b                             ", "user@fwebos:~$ echo b         "]
  expect acceptCursor(os, t0) == [2, 21]
  termKeys(os, t0, ["Up"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo b         ", "b                             ", "user@fwebos:~$ echo a         "]
  expect acceptCursor(os, t0) == [2, 21]
  termKeys(os, t0, ["Up"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo b         ", "b                             ", "user@fwebos:~$ echo a         "]
  expect acceptCursor(os, t0) == [2, 21]
  termKeys(os, t0, ["Down"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo b         ", "b                             ", "user@fwebos:~$ echo b         "]
  expect acceptCursor(os, t0) == [2, 21]
  termKeys(os, t0, ["Down"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo b         ", "b                             ", "user@fwebos:~$ draft          "]
  expect acceptCursor(os, t0) == [2, 20]
  termKeys(os, t0, ["Down"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo b         ", "b                             ", "user@fwebos:~$ draft          "]
  expect acceptCursor(os, t0) == [2, 20]
}

test "history skips repeats and blank lines" {
  var os = boot()
  var t0 = termNew(os, 30, 3)
  expect t0 == 1
  termType(os, t0, "echo a\necho a\n   \n\necho b\necho a\n")
  termKeys(os, t0, ["Up", "Up", "Up"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo a         ", "a                             ", "user@fwebos:~$ echo a         "]
  expect acceptCursor(os, t0) == [2, 21]
  termKeys(os, t0, ["Up"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo a         ", "a                             ", "user@fwebos:~$ echo a         "]
  expect acceptCursor(os, t0) == [2, 21]
}

test "editing a history entry ends browsing" {
  var os = boot()
  var t0 = termNew(os, 30, 3)
  expect t0 == 1
  termType(os, t0, "echo a\necho b\n")
  termKeys(os, t0, ["Up", "Up", "x", "Down"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo b         ", "b                             ", "user@fwebos:~$ echo ax        "]
  expect acceptCursor(os, t0) == [2, 22]
  termKeys(os, t0, ["Enter", "Up"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo ax        ", "ax                            ", "user@fwebos:~$ echo ax        "]
  expect acceptCursor(os, t0) == [2, 22]
}

test "ctrl-c" {
  var os = boot()
  var t0 = termNew(os, 30, 4)
  expect t0 == 1
  termType(os, t0, "abc")
  termKeys(os, t0, ["Ctrl-C"])
  expect termScreen(os, t0) == ["user@fwebos:~$ abc^C          ", "user@fwebos:~$                ", "                              ", "                              "]
  expect acceptCursor(os, t0) == [1, 15]
  termType(os, t0, "echo ok\n")
  expect termScreen(os, t0) == ["user@fwebos:~$ abc^C          ", "user@fwebos:~$ echo ok        ", "ok                            ", "user@fwebos:~$                "]
  expect acceptCursor(os, t0) == [3, 15]
}

test "clear and ctrl-l" {
  var os = boot()
  var t0 = termNew(os, 30, 4)
  expect t0 == 1
  termType(os, t0, "echo a\necho b\n")
  termType(os, t0, "clear\n")
  expect termScreen(os, t0) == ["user@fwebos:~$                ", "                              ", "                              ", "                              "]
  expect acceptCursor(os, t0) == [0, 15]
  termType(os, t0, "echo c\nec")
  termKeys(os, t0, ["Ctrl-L"])
  expect termScreen(os, t0) == ["user@fwebos:~$ ec             ", "                              ", "                              ", "                              "]
  expect acceptCursor(os, t0) == [0, 17]
  termType(os, t0, "echo x; clear; echo y\n")
  expect termScreen(os, t0) == ["y                             ", "user@fwebos:~$                ", "                              ", "                              "]
  expect acceptCursor(os, t0) == [1, 15]
}

test "tab completes commands" {
  var os = boot()
  var t0 = termNew(os, 40, 6)
  expect t0 == 1
  termType(os, t0, "ech")
  termKeys(os, t0, ["Tab"])
  expect termScreen(os, t0) == ["user@fwebos:~$ echo                     ", "                                        ", "                                        ", "                                        ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [0, 20]
  termKeys(os, t0, ["Ctrl-C"])
  termType(os, t0, "mk\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ echo ^C                  ", "user@fwebos:~$ mkdir                    ", "                                        ", "                                        ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [1, 21]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "s\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ s                        ", "seq  sh  sleep  sort  source            ", "user@fwebos:~$ s                        ", "                                        ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [2, 16]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "unk\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ unk                      ", "                                        ", "                                        ", "                                        ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [0, 18]
}

test "tab completes paths" {
  var os = boot()
  var t0 = termNew(os, 60, 8)
  expect t0 == 1
  termType(os, t0, "mkdir docs dev; touch notes.txt report1 report2 .secret\n")
  termKeys(os, t0, ["Ctrl-L"])
  termType(os, t0, "cat no\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ cat notes.txt                                ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [0, 29]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "cd do\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ cd docs/                                     ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [0, 23]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "cat re\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ cat report                                   ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [0, 25]
  termType(os, t0, "\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ cat report                                   ", "report1  report2                                            ", "user@fwebos:~$ cat report                                   ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [2, 25]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "ls d\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ ls d                                         ", "dev/  docs/                                                 ", "user@fwebos:~$ ls d                                         ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [2, 19]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "ls .\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ ls .secret                                   ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [0, 26]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "ls /ho\tus\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ ls /home/user/                               ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [0, 29]
  termKeys(os, t0, ["Ctrl-C", "Ctrl-L"])
  termType(os, t0, "cat zz\t")
  expect termScreen(os, t0) == ["user@fwebos:~$ cat zz                                       ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            ", "                                                            "]
  expect acceptCursor(os, t0) == [0, 21]
}

test "tab completes in the middle of the line" {
  var os = boot()
  var t0 = termNew(os, 40, 3)
  expect t0 == 1
  termType(os, t0, "cat no | wc")
  expect acceptSh(os, "touch notes") == ["", "", 0]
  termKeys(os, t0, ["Left", "Left", "Left", "Left", "Left", "Tab", "!"])
  expect termScreen(os, t0) == ["user@fwebos:~$ cat notes ! | wc         ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [0, 26]
}

test "jobs in a terminal write to its screen" {
  var os = boot()
  var t0 = termNew(os, 40, 6)
  expect t0 == 1
  termType(os, t0, "sleep 1 && echo bg &\n")
  expect termScreen(os, t0) == ["user@fwebos:~$ sleep 1 && echo bg &     ", "[1] 2                                   ", "user@fwebos:~$                          ", "                                        ", "                                        ", "                                        "]
  expect acceptCursor(os, t0) == [2, 15]
  expect acceptTick(os, 1000) == ["", ""]
  expect termScreen(os, t0) == ["user@fwebos:~$ sleep 1 && echo bg &     ", "[1] 2                                   ", "bg                                      ", "[1] Done sleep 1 && echo bg             ", "user@fwebos:~$                          ", "                                        "]
  expect acceptCursor(os, t0) == [4, 15]
}

test "terminals have their own sessions" {
  var os = boot()
  var t0 = termNew(os, 30, 4)
  expect t0 == 1
  var t1 = termNew(os, 30, 4)
  expect t1 == 2
  termType(os, t0, "cd /tmp; X=1\n")
  termType(os, t1, "echo $X; pwd\n")
  expect termScreen(os, t1) == ["user@fwebos:~$ echo $X; pwd   ", "                              ", "/home/user                    ", "user@fwebos:~$                "]
  expect acceptCursor(os, t1) == [3, 15]
  expect acceptSh(os, "pwd") == ["/home/user\n", "", 0]
  termType(os, t0, "touch shared\n")
  expect acceptSh(os, "ls /tmp") == ["shared\n", "", 0]
}
