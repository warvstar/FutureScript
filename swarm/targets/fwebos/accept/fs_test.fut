// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/os.fut"

fn acceptSh(os, line) {
  var r = sh(os, line)
  return [r.out, r.err, r.code]
}

fn acceptSyntax(os, line) {
  var r = sh(os, line)
  return r.code == 2 && r.out == "" && r.err.find("sh: syntax error: ") == 0
}

fn acceptTick(os, ms) {
  var r = tick(os, ms)
  return [r.out, r.err]
}

fn acceptWins(os) {
  var r = []
  for w in wmList(os) { r.push([w.id, w.app, w.title, w.x, w.y, w.w, w.h, w.focused, w.minimized, w.maximized]) }
  return r
}

fn acceptCursor(os, t) {
  var c = termCursor(os, t)
  return [c.row, c.col]
}

test "a new OS has its directories and starts at home" {
  var os = boot()
  expect acceptSh(os, "ls /") == ["home\ntmp\n", "", 0]
  expect acceptSh(os, "ls /home") == ["user\n", "", 0]
  expect acceptSh(os, "pwd") == ["/home/user\n", "", 0]
  expect acceptSh(os, "ls") == ["", "", 0]
  expect acceptSh(os, "ls /tmp") == ["", "", 0]
  expect acceptSh(os, "echo $HOME $USER $PWD") == ["/home/user user /home/user\n", "", 0]
}

test "cd and pwd" {
  var os = boot()
  expect acceptSh(os, "cd /tmp") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/tmp\n", "", 0]
  expect acceptSh(os, "cd ..") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/\n", "", 0]
  expect acceptSh(os, "cd") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/home/user\n", "", 0]
  expect acceptSh(os, "cd ../..") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/\n", "", 0]
  expect acceptSh(os, "cd ..") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/\n", "", 0]
  expect acceptSh(os, "cd ~") == ["", "", 0]
  expect acceptSh(os, "echo $PWD") == ["/home/user\n", "", 0]
  expect acceptSh(os, "cd /home/./user//") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/home/user\n", "", 0]
}

test "cd errors" {
  var os = boot()
  expect acceptSh(os, "cd nope") == ["", "cd: nope: No such file or directory\n", 1]
  expect acceptSh(os, "touch f") == ["", "", 0]
  expect acceptSh(os, "cd f") == ["", "cd: f: Not a directory\n", 1]
  expect acceptSh(os, "pwd") == ["/home/user\n", "", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
}

test "mkdir, touch and ls" {
  var os = boot()
  expect acceptSh(os, "mkdir a b") == ["", "", 0]
  expect acceptSh(os, "touch a/x a/y b/z") == ["", "", 0]
  expect acceptSh(os, "ls") == ["a\nb\n", "", 0]
  expect acceptSh(os, "ls a") == ["x\ny\n", "", 0]
  expect acceptSh(os, "ls a/x") == ["a/x\n", "", 0]
  expect acceptSh(os, "mkdir a") == ["", "mkdir: a: File exists\n", 1]
  expect acceptSh(os, "mkdir q/r") == ["", "mkdir: q/r: No such file or directory\n", 1]
  expect acceptSh(os, "mkdir -p q/r/s") == ["", "", 0]
  expect acceptSh(os, "ls q/r") == ["s\n", "", 0]
  expect acceptSh(os, "mkdir -p q/r") == ["", "", 0]
  expect acceptSh(os, "touch nope/f") == ["", "touch: nope/f: No such file or directory\n", 1]
  expect acceptSh(os, "ls") == ["a\nb\nq\n", "", 0]
}

test "ls with several paths" {
  var os = boot()
  expect acceptSh(os, "mkdir d e") == ["", "", 0]
  expect acceptSh(os, "touch f g d/1 d/2") == ["", "", 0]
  expect acceptSh(os, "ls d g e missing f") == ["g\nf\n\nd:\n1\n2\n\ne:\n", "ls: missing: No such file or directory\n", 1]
  expect acceptSh(os, "ls d e") == ["d:\n1\n2\n\ne:\n", "", 0]
  expect acceptSh(os, "ls missing") == ["", "ls: missing: No such file or directory\n", 1]
}

test "ls -a shows dotfiles" {
  var os = boot()
  expect acceptSh(os, "touch .hidden visible") == ["", "", 0]
  expect acceptSh(os, "mkdir .cfg") == ["", "", 0]
  expect acceptSh(os, "ls") == ["visible\n", "", 0]
  expect acceptSh(os, "ls -a") == [".cfg\n.hidden\nvisible\n", "", 0]
  expect acceptSh(os, "ls -a .cfg") == ["", "", 0]
}

test "paths are normalized" {
  var os = boot()
  expect acceptSh(os, "mkdir -p a/b/c") == ["", "", 0]
  expect acceptSh(os, "cd a/./b/../b//c") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/home/user/a/b/c\n", "", 0]
  expect acceptSh(os, "ls /../home/./user") == ["a\n", "", 0]
  expect acceptSh(os, "cd ../../../../../../..") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/\n", "", 0]
  expect acceptSh(os, "ls /home/user/a/b/c/../..") == ["b\n", "", 0]
}

test "cat files and errors" {
  var os = boot()
  expect acceptSh(os, "echo hello > f") == ["", "", 0]
  expect acceptSh(os, "echo world > g") == ["", "", 0]
  expect acceptSh(os, "cat f") == ["hello\n", "", 0]
  expect acceptSh(os, "cat f g f") == ["hello\nworld\nhello\n", "", 0]
  expect acceptSh(os, "cat f missing g") == ["hello\nworld\n", "cat: missing: No such file or directory\n", 1]
  expect acceptSh(os, "mkdir d") == ["", "", 0]
  expect acceptSh(os, "cat d") == ["", "cat: d: Is a directory\n", 1]
  expect acceptSh(os, "touch f") == ["", "", 0]
  expect acceptSh(os, "cat f") == ["hello\n", "", 0]
}

test "redirecting output" {
  var os = boot()
  expect acceptSh(os, "echo a > f") == ["", "", 0]
  expect acceptSh(os, "echo b >> f") == ["", "", 0]
  expect acceptSh(os, "cat f") == ["a\nb\n", "", 0]
  expect acceptSh(os, "echo c > f") == ["", "", 0]
  expect acceptSh(os, "cat f") == ["c\n", "", 0]
  expect acceptSh(os, "echo d >> new") == ["", "", 0]
  expect acceptSh(os, "cat new") == ["d\n", "", 0]
  expect acceptSh(os, "echo x > f y z") == ["", "", 0]
  expect acceptSh(os, "cat f") == ["x y z\n", "", 0]
  expect acceptSh(os, "> empty") == ["", "", 0]
  expect acceptSh(os, "cat empty") == ["", "", 0]
  expect acceptSh(os, "ls") == ["empty\nf\nnew\n", "", 0]
}

test "redirection errors" {
  var os = boot()
  expect acceptSh(os, "echo x > nope/f") == ["", "sh: nope/f: No such file or directory\n", 1]
  expect acceptSh(os, "mkdir d") == ["", "", 0]
  expect acceptSh(os, "echo x > d") == ["", "sh: d: Is a directory\n", 1]
  expect acceptSh(os, "cat < missing") == ["", "sh: missing: No such file or directory\n", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "ls") == ["d\n", "", 0]
}

test "reading standard input from a file" {
  var os = boot()
  expect acceptSh(os, "echo hello > f") == ["", "", 0]
  expect acceptSh(os, "cat < f") == ["hello\n", "", 0]
  expect acceptSh(os, "wc -c < f") == ["6\n", "", 0]
  expect acceptSh(os, "cat < f | wc -l") == ["1\n", "", 0]
}

test "stderr redirection" {
  var os = boot()
  expect acceptSh(os, "cat missing 2> e") == ["", "", 1]
  expect acceptSh(os, "cat e") == ["cat: missing: No such file or directory\n", "", 0]
  expect acceptSh(os, "cat missing > o 2>&1") == ["", "", 1]
  expect acceptSh(os, "cat o") == ["cat: missing: No such file or directory\n", "", 0]
  expect acceptSh(os, "cat missing 2>&1 > o2") == ["cat: missing: No such file or directory\n", "", 1]
  expect acceptSh(os, "cat o2") == ["", "", 0]
}

test "rm" {
  var os = boot()
  expect acceptSh(os, "touch f g") == ["", "", 0]
  expect acceptSh(os, "mkdir -p d/sub") == ["", "", 0]
  expect acceptSh(os, "touch d/sub/x") == ["", "", 0]
  expect acceptSh(os, "rm f") == ["", "", 0]
  expect acceptSh(os, "ls") == ["d\ng\n", "", 0]
  expect acceptSh(os, "rm f") == ["", "rm: f: No such file or directory\n", 1]
  expect acceptSh(os, "rm -f f") == ["", "", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
  expect acceptSh(os, "rm d") == ["", "rm: d: Is a directory\n", 1]
  expect acceptSh(os, "rm -r d") == ["", "", 0]
  expect acceptSh(os, "ls") == ["g\n", "", 0]
  expect acceptSh(os, "mkdir e") == ["", "", 0]
  expect acceptSh(os, "rm -rf e g missing") == ["", "", 0]
  expect acceptSh(os, "ls") == ["", "", 0]
}

test "cp" {
  var os = boot()
  expect acceptSh(os, "echo hi > f") == ["", "", 0]
  expect acceptSh(os, "mkdir d") == ["", "", 0]
  expect acceptSh(os, "cp f g") == ["", "", 0]
  expect acceptSh(os, "cat g") == ["hi\n", "", 0]
  expect acceptSh(os, "cp f d") == ["", "", 0]
  expect acceptSh(os, "ls d") == ["f\n", "", 0]
  expect acceptSh(os, "cp d e") == ["", "cp: d: Is a directory\n", 1]
  expect acceptSh(os, "cp -r d e") == ["", "", 0]
  expect acceptSh(os, "ls e") == ["f\n", "", 0]
  expect acceptSh(os, "cp missing x") == ["", "cp: missing: No such file or directory\n", 1]
  expect acceptSh(os, "cp f nope/x") == ["", "cp: nope/x: No such file or directory\n", 1]
  expect acceptSh(os, "echo bye > f") == ["", "", 0]
  expect acceptSh(os, "cp f g") == ["", "", 0]
  expect acceptSh(os, "cat g d/f") == ["bye\nhi\n", "", 0]
}

test "mv" {
  var os = boot()
  expect acceptSh(os, "echo hi > f") == ["", "", 0]
  expect acceptSh(os, "mkdir d") == ["", "", 0]
  expect acceptSh(os, "mv f g") == ["", "", 0]
  expect acceptSh(os, "ls") == ["d\ng\n", "", 0]
  expect acceptSh(os, "mv g d") == ["", "", 0]
  expect acceptSh(os, "ls d") == ["g\n", "", 0]
  expect acceptSh(os, "mv d e") == ["", "", 0]
  expect acceptSh(os, "ls") == ["e\n", "", 0]
  expect acceptSh(os, "cat e/g") == ["hi\n", "", 0]
  expect acceptSh(os, "mv missing x") == ["", "mv: missing: No such file or directory\n", 1]
  expect acceptSh(os, "mv e/g nope/g") == ["", "mv: nope/g: No such file or directory\n", 1]
}

test "find" {
  var os = boot()
  expect acceptSh(os, "mkdir -p p/q") == ["", "", 0]
  expect acceptSh(os, "touch p/a.txt p/q/b.txt p/q/c.md p/.h") == ["", "", 0]
  expect acceptSh(os, "find p") == ["p\np/.h\np/a.txt\np/q\np/q/b.txt\np/q/c.md\n", "", 0]
  expect acceptSh(os, "find p -type f") == ["p/.h\np/a.txt\np/q/b.txt\np/q/c.md\n", "", 0]
  expect acceptSh(os, "find p -type d") == ["p\np/q\n", "", 0]
  expect acceptSh(os, "find p -name *.txt") == ["p/a.txt\np/q/b.txt\n", "", 0]
  expect acceptSh(os, "find p/") == ["p/\np/.h\np/a.txt\np/q\np/q/b.txt\np/q/c.md\n", "", 0]
  expect acceptSh(os, "cd p") == ["", "", 0]
  expect acceptSh(os, "find") == [".\n./.h\n./a.txt\n./q\n./q/b.txt\n./q/c.md\n", "", 0]
  expect acceptSh(os, "find . -name c*") == ["./q/c.md\n", "", 0]
  expect acceptSh(os, "find missing") == ["", "find: missing: No such file or directory\n", 1]
  expect acceptSh(os, "find a.txt") == ["a.txt\n", "", 0]
}

test "save and load keep the file system and nothing else" {
  var os = boot()
  expect acceptSh(os, "mkdir -p a/b /tmp/empty") == ["", "", 0]
  expect acceptSh(os, "echo 'quote \" brace \{ back \\ tab\tend' > a/b/f") == ["", "", 0]
  expect acceptSh(os, "touch a/e") == ["", "", 0]
  expect acceptSh(os, "cd a") == ["", "", 0]
  expect acceptSh(os, "X=1") == ["", "", 0]
  var os2 = load(save(os))
  expect acceptSh(os2, "pwd") == ["/home/user\n", "", 0]
  expect acceptSh(os2, "echo [$X]") == ["[]\n", "", 0]
  expect acceptSh(os2, "cat /home/user/a/b/f") == ["quote \" brace \{ back \\ tab\tend\n", "", 0]
  expect acceptSh(os2, "ls /home/user/a") == ["b\ne\n", "", 0]
  expect acceptSh(os2, "ls /tmp") == ["empty\n", "", 0]
  expect acceptSh(os2, "find /home") == ["/home\n/home/user\n/home/user/a\n/home/user/a/b\n/home/user/a/b/f\n/home/user/a/e\n", "", 0]
  expect acceptSh(os, "rm -r /home/user/a") == ["", "", 0]
  expect acceptSh(os, "ls /home/user") == ["", "", 0]
  expect acceptSh(os2, "ls /home/user") == ["a\n", "", 0]
}
