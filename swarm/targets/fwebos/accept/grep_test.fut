// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/os.fut"

fn acceptSh(os, line) {
  var r = sh(os, line)
  return [r.out, r.err, r.code]
}

test "grep options" {
  var os = boot()
  expect acceptSh(os, "echo 'apple pie' >> t; echo 'Apple Tart' >> t; echo 'banana' >> t; echo 'cherry' >> t; echo '' >> t; echo 'a.b' >> t; echo 'a+b' >> t; echo 'aab' >> t; echo 'abbb' >> t; echo '[x]' >> t; echo 'x-y' >> t; echo 'end$' >> t; echo '^start' >> t; echo 'tab\there' >> t; echo 'color colour' >> t; echo '123-456' >> t; echo 'zzz' >> t") == ["", "", 0]
  expect acceptSh(os, "grep apple t") == ["apple pie\n", "", 0]
  expect acceptSh(os, "grep -i apple t") == ["apple pie\nApple Tart\n", "", 0]
  expect acceptSh(os, "grep -v a t") == ["cherry\n\n[x]\nx-y\nend$\ncolor colour\n123-456\nzzz\n", "", 0]
  expect acceptSh(os, "grep -c a t") == ["9\n", "", 0]
  expect acceptSh(os, "grep -n an t") == ["3:banana\n", "", 0]
  expect acceptSh(os, "grep -in APPLE t") == ["1:apple pie\n2:Apple Tart\n", "", 0]
  expect acceptSh(os, "grep nomatch t") == ["", "", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "grep -c nomatch t") == ["0\n", "", 1]
  expect acceptSh(os, "echo hi | grep h") == ["hi\n", "", 0]
  expect acceptSh(os, "echo apple > u") == ["", "", 0]
  expect acceptSh(os, "grep apple t u") == ["t:apple pie\nu:apple\n", "", 0]
  expect acceptSh(os, "grep -c apple t u") == ["t:1\nu:1\n", "", 0]
  expect acceptSh(os, "grep apple missing") == ["", "grep: missing: No such file or directory\n", 2]
  expect acceptSh(os, "echo $?") == ["2\n", "", 0]
  expect acceptSh(os, "grep apple missing t") == ["t:apple pie\n", "grep: missing: No such file or directory\n", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
  expect acceptSh(os, "grep -v '' t") == ["", "", 1]
}

test "grep regular expressions 1" {
  var os = boot()
  expect acceptSh(os, "echo 'apple pie' >> t; echo 'Apple Tart' >> t; echo 'banana' >> t; echo 'cherry' >> t; echo '' >> t; echo 'a.b' >> t; echo 'a+b' >> t; echo 'aab' >> t; echo 'abbb' >> t; echo '[x]' >> t; echo 'x-y' >> t; echo 'end$' >> t; echo '^start' >> t; echo 'tab\there' >> t; echo 'color colour' >> t; echo '123-456' >> t; echo 'zzz' >> t") == ["", "", 0]
  expect acceptSh(os, "grep -n 'a.b' t") == ["6:a.b\n7:a+b\n8:aab\n9:abbb\n", "", 0]
  expect acceptSh(os, "grep -n 'a\\.b' t") == ["6:a.b\n", "", 0]
  expect acceptSh(os, "grep -n 'a+b' t") == ["8:aab\n9:abbb\n14:tab\there\n", "", 0]
  expect acceptSh(os, "grep -n 'a\\+b' t") == ["7:a+b\n", "", 0]
  expect acceptSh(os, "grep -n 'aa*b' t") == ["8:aab\n9:abbb\n14:tab\there\n", "", 0]
  expect acceptSh(os, "grep -n 'ab+' t") == ["8:aab\n9:abbb\n14:tab\there\n", "", 0]
  expect acceptSh(os, "grep -n 'ab?b' t") == ["8:aab\n9:abbb\n14:tab\there\n", "", 0]
  expect acceptSh(os, "grep -n '^a' t") == ["1:apple pie\n6:a.b\n7:a+b\n8:aab\n9:abbb\n", "", 0]
  expect acceptSh(os, "grep -n '^$' t") == ["5:\n", "", 0]
  expect acceptSh(os, "grep -n 'b$' t") == ["6:a.b\n7:a+b\n8:aab\n9:abbb\n", "", 0]
  expect acceptSh(os, "grep -n 'e$' t") == ["1:apple pie\n14:tab\there\n", "", 0]
  expect acceptSh(os, "grep -n 'end\\$' t") == ["12:end$\n", "", 0]
}

test "grep regular expressions 2" {
  var os = boot()
  expect acceptSh(os, "echo 'apple pie' >> t; echo 'Apple Tart' >> t; echo 'banana' >> t; echo 'cherry' >> t; echo '' >> t; echo 'a.b' >> t; echo 'a+b' >> t; echo 'aab' >> t; echo 'abbb' >> t; echo '[x]' >> t; echo 'x-y' >> t; echo 'end$' >> t; echo '^start' >> t; echo 'tab\there' >> t; echo 'color colour' >> t; echo '123-456' >> t; echo 'zzz' >> t") == ["", "", 0]
  expect acceptSh(os, "grep -n 'end$' t") == ["", "", 1]
  expect acceptSh(os, "grep -n '^\\^' t") == ["13:^start\n", "", 0]
  expect acceptSh(os, "grep -n 's^t' t") == ["", "", 1]
  expect acceptSh(os, "grep -n '[xyz]' t") == ["4:cherry\n10:[x]\n11:x-y\n17:zzz\n", "", 0]
  expect acceptSh(os, "grep -n '[^a-z ]' t") == ["2:Apple Tart\n6:a.b\n7:a+b\n10:[x]\n11:x-y\n12:end$\n13:^start\n14:tab\there\n16:123-456\n", "", 0]
  expect acceptSh(os, "grep -n '^[a-c]' t") == ["1:apple pie\n3:banana\n4:cherry\n6:a.b\n7:a+b\n8:aab\n9:abbb\n15:color colour\n", "", 0]
  expect acceptSh(os, "grep -n '[]x]' t") == ["10:[x]\n11:x-y\n", "", 0]
  expect acceptSh(os, "grep -n '[-]' t") == ["11:x-y\n16:123-456\n", "", 0]
  expect acceptSh(os, "grep -n '[x-]' t") == ["10:[x]\n11:x-y\n16:123-456\n", "", 0]
  expect acceptSh(os, "grep -n 'colou?r' t") == ["15:color colour\n", "", 0]
  expect acceptSh(os, "grep -n '^.$' t") == ["", "", 1]
  expect acceptSh(os, "grep -n '^...$' t") == ["6:a.b\n7:a+b\n8:aab\n10:[x]\n11:x-y\n17:zzz\n", "", 0]
}

test "grep regular expressions 3" {
  var os = boot()
  expect acceptSh(os, "echo 'apple pie' >> t; echo 'Apple Tart' >> t; echo 'banana' >> t; echo 'cherry' >> t; echo '' >> t; echo 'a.b' >> t; echo 'a+b' >> t; echo 'aab' >> t; echo 'abbb' >> t; echo '[x]' >> t; echo 'x-y' >> t; echo 'end$' >> t; echo '^start' >> t; echo 'tab\there' >> t; echo 'color colour' >> t; echo '123-456' >> t; echo 'zzz' >> t") == ["", "", 0]
  expect acceptSh(os, "grep -n '[0-9]+-[0-9]+' t") == ["16:123-456\n", "", 0]
  expect acceptSh(os, "grep -n '*' t") == ["", "", 1]
  expect acceptSh(os, "grep -n '+b' t") == ["7:a+b\n", "", 0]
  expect acceptSh(os, "grep -n 'a**' t") == ["", "", 1]
  expect acceptSh(os, "grep -n '\\[x' t") == ["10:[x]\n", "", 0]
  expect acceptSh(os, "grep -n '[abc' t") == ["", "", 1]
  expect acceptSh(os, "grep -n 't.*e' t") == ["14:tab\there\n", "", 0]
  expect acceptSh(os, "grep -n '^[^a]*$' t") == ["4:cherry\n5:\n10:[x]\n11:x-y\n12:end$\n15:color colour\n16:123-456\n17:zzz\n", "", 0]
  expect acceptSh(os, "grep -n 'tab.here' t") == ["14:tab\there\n", "", 0]
  expect acceptSh(os, "grep -n 'p.e' t") == ["1:apple pie\n2:Apple Tart\n", "", 0]
  expect acceptSh(os, "grep -n 'z+$' t") == ["17:zzz\n", "", 0]
}

test "grep -i with classes" {
  var os = boot()
  expect acceptSh(os, "echo 'apple pie' >> t; echo 'Apple Tart' >> t; echo 'banana' >> t; echo 'cherry' >> t; echo '' >> t; echo 'a.b' >> t; echo 'a+b' >> t; echo 'aab' >> t; echo 'abbb' >> t; echo '[x]' >> t; echo 'x-y' >> t; echo 'end$' >> t; echo '^start' >> t; echo 'tab\there' >> t; echo 'color colour' >> t; echo '123-456' >> t; echo 'zzz' >> t") == ["", "", 0]
  expect acceptSh(os, "grep -i '^[a]' t") == ["apple pie\nApple Tart\na.b\na+b\naab\nabbb\n", "", 0]
  expect acceptSh(os, "grep -i '[^a-z]PPLE' t") == ["", "", 1]
  expect acceptSh(os, "grep -i 'B+' t") == ["banana\na.b\na+b\naab\nabbb\ntab\there\n", "", 0]
  expect acceptSh(os, "grep -ic 'A' t") == ["9\n", "", 0]
}
