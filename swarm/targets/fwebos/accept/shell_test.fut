// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/os.fut"

fn acceptSh(os, line) {
  var r = sh(os, line)
  return [r.out, r.err, r.code]
}

fn acceptSyntax(os, line) {
  var r = sh(os, line)
  return r.code == 2 && r.out == "" && r.err.find("sh: syntax error: ") == 0
}

fn acceptTick(os, ms) {
  var r = tick(os, ms)
  return [r.out, r.err]
}

fn acceptWins(os) {
  var r = []
  for w in wmList(os) { r.push([w.id, w.app, w.title, w.x, w.y, w.w, w.h, w.focused, w.minimized, w.maximized]) }
  return r
}

fn acceptCursor(os, t) {
  var c = termCursor(os, t)
  return [c.row, c.col]
}

test "echo and quoting" {
  var os = boot()
  expect acceptSh(os, "echo a   b") == ["a b\n", "", 0]
  expect acceptSh(os, "echo \"a   b\"") == ["a   b\n", "", 0]
  expect acceptSh(os, "echo 'a $X \"b\"'") == ["a $X \"b\"\n", "", 0]
  expect acceptSh(os, "echo a\\ \\ b") == ["a  b\n", "", 0]
  expect acceptSh(os, "echo \"q\\\"x\\\\y\\$z\\n\"") == ["q\"x\\y$z\\n\n", "", 0]
  expect acceptSh(os, "echo -n hi") == ["hi", "", 0]
  expect acceptSh(os, "echo -n a b") == ["a b", "", 0]
  expect acceptSh(os, "echo") == ["\n", "", 0]
  expect acceptSh(os, "echo it\\'s") == ["it's\n", "", 0]
  expect acceptSh(os, "echo \"\"x''") == ["x\n", "", 0]
  expect acceptSh(os, "echo $ 5$ a$-") == ["$ 5$ a$-\n", "", 0]
}

test "variables" {
  var os = boot()
  expect acceptSh(os, "X=hello") == ["", "", 0]
  expect acceptSh(os, "echo $X $\{X}world $Y.") == ["hello helloworld .\n", "", 0]
  expect acceptSh(os, "echo \"$X\"") == ["hello\n", "", 0]
  expect acceptSh(os, "A=1 B=$A") == ["", "", 0]
  expect acceptSh(os, "echo $A$B") == ["11\n", "", 0]
  expect acceptSh(os, "X=\"a  b\"") == ["", "", 0]
  expect acceptSh(os, "Y=$X") == ["", "", 0]
  expect acceptSh(os, "echo \"$Y\"") == ["a  b\n", "", 0]
  expect acceptSh(os, "echo '$X'") == ["$X\n", "", 0]
  expect acceptSh(os, "X=") == ["", "", 0]
  expect acceptSh(os, "echo [$X]") == ["[]\n", "", 0]
}

test "exit status" {
  var os = boot()
  expect acceptSh(os, "false") == ["", "", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "true") == ["", "", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
  expect acceptSh(os, "nope") == ["", "sh: nope: command not found\n", 127]
  expect acceptSh(os, "echo $?") == ["127\n", "", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
}

test "and, or" {
  var os = boot()
  expect acceptSh(os, "true && echo a") == ["a\n", "", 0]
  expect acceptSh(os, "false && echo b") == ["", "", 1]
  expect acceptSh(os, "false || echo c") == ["c\n", "", 0]
  expect acceptSh(os, "true || echo d") == ["", "", 0]
  expect acceptSh(os, "false && echo x || echo y") == ["y\n", "", 0]
  expect acceptSh(os, "true || echo x && echo z") == ["z\n", "", 0]
  expect acceptSh(os, "false && echo x") == ["", "", 1]
}

test "lists and comments" {
  var os = boot()
  expect acceptSh(os, "echo a; echo b # not this") == ["a\nb\n", "", 0]
  expect acceptSh(os, "echo a;echo b;") == ["a\nb\n", "", 0]
  expect acceptSh(os, "false") == ["", "", 1]
  expect acceptSh(os, "# only a comment") == ["", "", 0]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "false") == ["", "", 1]
  expect acceptSh(os, "") == ["", "", 0]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "echo a#b") == ["a#b\n", "", 0]
  expect acceptSh(os, "echo one\necho two") == ["one\ntwo\n", "", 0]
}

test "field splitting" {
  var os = boot()
  expect acceptSh(os, "X=\"a   b  c\"") == ["", "", 0]
  expect acceptSh(os, "for w in $X; do echo \"<$w>\"; done") == ["<a>\n<b>\n<c>\n", "", 0]
  expect acceptSh(os, "for w in \"$X\"; do echo \"<$w>\"; done") == ["<a   b  c>\n", "", 0]
  expect acceptSh(os, "E=") == ["", "", 0]
  expect acceptSh(os, "for w in a $E \"\" \"$E\" b$E; do echo \"[$w]\"; done") == ["[a]\n[]\n[]\n[b]\n", "", 0]
  expect acceptSh(os, "S=\" x y \"") == ["", "", 0]
  expect acceptSh(os, "for w in a$S\"b\"; do echo \"[$w]\"; done") == ["[a]\n[x]\n[y]\n[b]\n", "", 0]
}

test "command substitution" {
  var os = boot()
  expect acceptSh(os, "echo $(echo hi)") == ["hi\n", "", 0]
  expect acceptSh(os, "X=$(pwd)") == ["", "", 0]
  expect acceptSh(os, "echo $X") == ["/home/user\n", "", 0]
  expect acceptSh(os, "echo \"$(echo a; echo b)\"") == ["a\nb\n", "", 0]
  expect acceptSh(os, "echo $(echo a; echo b)") == ["a b\n", "", 0]
  expect acceptSh(os, "echo $(echo $(echo deep))") == ["deep\n", "", 0]
  expect acceptSh(os, "echo \"[$(echo; echo)]\"") == ["[]\n", "", 0]
  expect acceptSh(os, "echo $(nope)x") == ["x\n", "sh: nope: command not found\n", 0]
  expect acceptSh(os, "echo \"$(echo \"in quotes\")\"") == ["in quotes\n", "", 0]
}

test "command substitution runs in a copy of the session" {
  var os = boot()
  expect acceptSh(os, "X=1") == ["", "", 0]
  expect acceptSh(os, "echo $(X=2; cd /; echo $X $PWD)") == ["2 /\n", "", 0]
  expect acceptSh(os, "echo $X $PWD") == ["1 /home/user\n", "", 0]
  expect acceptSh(os, "echo $(touch made)") == ["\n", "", 0]
  expect acceptSh(os, "ls") == ["made\n", "", 0]
}

test "arithmetic" {
  var os = boot()
  expect acceptSh(os, "echo $((1+2*3)) $(((1+2)*3)) $((7/2)) $((-7/2)) $((-7%3)) $((7%-3)) $((2-3-4)) $((2*-3))") == ["7 9 3 -3 -1 1 -5 -6\n", "", 0]
  expect acceptSh(os, "X=5") == ["", "", 0]
  expect acceptSh(os, "echo $((X*2)) $(($X+1)) $((Y+1)) $(( X - - 1 ))") == ["10 6 1 6\n", "", 0]
  expect acceptSh(os, "S=abc") == ["", "", 0]
  expect acceptSh(os, "echo $((S+1))") == ["1\n", "", 0]
  expect acceptSh(os, "N=-4") == ["", "", 0]
  expect acceptSh(os, "echo $((N*N))") == ["16\n", "", 0]
  expect acceptSh(os, "false") == ["", "", 1]
  expect acceptSh(os, "echo $(($?+10))") == ["11\n", "", 0]
  expect acceptSh(os, "i=0") == ["", "", 0]
  expect acceptSh(os, "i=$((i+1))") == ["", "", 0]
  expect acceptSh(os, "i=$((i+1))") == ["", "", 0]
  expect acceptSh(os, "echo $i") == ["2\n", "", 0]
}

test "division by zero" {
  var os = boot()
  expect acceptSh(os, "echo $((1/0))") == ["", "sh: division by zero\n", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "echo $((5%0)) after") == ["", "sh: division by zero\n", 1]
  expect acceptSh(os, "X=$((1/0))") == ["", "sh: division by zero\n", 1]
  expect acceptSh(os, "echo [$X]") == ["[]\n", "", 0]
}

test "tilde" {
  var os = boot()
  expect acceptSh(os, "echo ~ ~/x a~ \"~\" ~x") == ["/home/user /home/user/x a~ ~ ~x\n", "", 0]
  expect acceptSh(os, "HOME=/tmp") == ["", "", 0]
  expect acceptSh(os, "echo ~") == ["/tmp\n", "", 0]
  expect acceptSh(os, "cd") == ["", "", 0]
  expect acceptSh(os, "pwd") == ["/tmp\n", "", 0]
}

test "globs" {
  var os = boot()
  expect acceptSh(os, "touch a.txt b.txt c.md .h.txt") == ["", "", 0]
  expect acceptSh(os, "echo *.txt") == ["a.txt b.txt\n", "", 0]
  expect acceptSh(os, "echo ?.md") == ["c.md\n", "", 0]
  expect acceptSh(os, "echo *.none") == ["*.none\n", "", 0]
  expect acceptSh(os, "echo \"*.txt\"") == ["*.txt\n", "", 0]
  expect acceptSh(os, "echo \\*.txt") == ["*.txt\n", "", 0]
  expect acceptSh(os, "echo .*.txt") == [".h.txt\n", "", 0]
  expect acceptSh(os, "mkdir d") == ["", "", 0]
  expect acceptSh(os, "touch d/x1 d/x2 d/y") == ["", "", 0]
  expect acceptSh(os, "echo d/x*") == ["d/x1 d/x2\n", "", 0]
  expect acceptSh(os, "X=\"*.txt\"") == ["", "", 0]
  expect acceptSh(os, "echo $X") == ["*.txt\n", "", 0]
  expect acceptSh(os, "echo *") == ["a.txt b.txt c.md d\n", "", 0]
  expect acceptSh(os, "cd d") == ["", "", 0]
  expect acceptSh(os, "echo ../*.md") == ["../c.md\n", "", 0]
  expect acceptSh(os, "ls *") == ["x1\nx2\ny\n", "", 0]
}

test "if" {
  var os = boot()
  expect acceptSh(os, "if true; then echo y; fi") == ["y\n", "", 0]
  expect acceptSh(os, "if false; then echo y; else echo n; fi") == ["n\n", "", 0]
  expect acceptSh(os, "X=2") == ["", "", 0]
  expect acceptSh(os, "if [ $X = 1 ]; then echo one; elif [ $X = 2 ]; then echo two; else echo other; fi") == ["two\n", "", 0]
  expect acceptSh(os, "if false; then echo x; fi") == ["", "", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
  expect acceptSh(os, "if false; then true; else false; fi") == ["", "", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "if true\nthen\n  echo multi\nfi") == ["multi\n", "", 0]
}

test "for" {
  var os = boot()
  expect acceptSh(os, "for i in 1 2 3; do echo $i; done") == ["1\n2\n3\n", "", 0]
  expect acceptSh(os, "touch b.txt a.txt") == ["", "", 0]
  expect acceptSh(os, "for f in *.txt; do echo file $f; done") == ["file a.txt\nfile b.txt\n", "", 0]
  expect acceptSh(os, "for i in; do echo never; done") == ["", "", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
  expect acceptSh(os, "for i in x y\ndo\n  echo $i\ndone") == ["x\ny\n", "", 0]
  expect acceptSh(os, "echo $i") == ["y\n", "", 0]
  expect acceptSh(os, "for i in 1 2; do for j in a b; do echo $i$j; done; done") == ["1a\n1b\n2a\n2b\n", "", 0]
}

test "while" {
  var os = boot()
  expect acceptSh(os, "i=0") == ["", "", 0]
  expect acceptSh(os, "while [ $i -lt 3 ]; do echo $i; i=$((i+1)); done") == ["0\n1\n2\n", "", 0]
  expect acceptSh(os, "echo $i") == ["3\n", "", 0]
  expect acceptSh(os, "while false; do echo never; done") == ["", "", 0]
  expect acceptSh(os, "echo $?") == ["0\n", "", 0]
  expect acceptSh(os, "n=5; s=0; while [ $n -gt 0 ]; do s=$((s+n)); n=$((n-1)); done; echo $s") == ["15\n", "", 0]
}

test "compound commands in pipelines and lists" {
  var os = boot()
  expect acceptSh(os, "for i in 3 1 2; do echo $i; done | sort") == ["1\n2\n3\n", "", 0]
  expect acceptSh(os, "if true; then echo a; fi && echo b") == ["a\nb\n", "", 0]
  expect acceptSh(os, "while false; do true; done || echo c") == ["", "", 0]
}

test "syntax errors run nothing" {
  var os = boot()
  expect acceptSyntax(os, "echo \"abc")
  expect acceptSyntax(os, "echo 'x")
  expect acceptSyntax(os, "| echo")
  expect acceptSyntax(os, "echo a &&")
  expect acceptSyntax(os, "echo a ;; echo b")
  expect acceptSyntax(os, "if true; then echo a")
  expect acceptSyntax(os, "for x; do echo; done")
  expect acceptSyntax(os, "done")
  expect acceptSyntax(os, "echo >")
  expect acceptSyntax(os, "if true; then echo a; fi > f")
  expect acceptSyntax(os, "while true; do; done")
  expect acceptSyntax(os, "echo a; echo \"b")
  expect acceptSyntax(os, "then echo")
  expect acceptSyntax(os, "echo $(echo a")
  expect acceptSyntax(os, "echo $\{X")
  expect acceptSh(os, "echo $?") == ["2\n", "", 0]
  expect acceptSh(os, "ls") == ["", "", 0]
}

test "command not found" {
  var os = boot()
  expect acceptSh(os, "nope arg") == ["", "sh: nope: command not found\n", 127]
  expect acceptSh(os, "X=1 echo hi") == ["", "sh: X=1: command not found\n", 127]
  expect acceptSh(os, "echo ok; nope; echo $?") == ["ok\n127\n", "sh: nope: command not found\n", 0]
}

test "pipes" {
  var os = boot()
  expect acceptSh(os, "echo hello | cat") == ["hello\n", "", 0]
  expect acceptSh(os, "echo a b c | wc -w") == ["3\n", "", 0]
  expect acceptSh(os, "seq 1 5 | tail -n 2 | head -n 1") == ["4\n", "", 0]
  expect acceptSh(os, "cat missing | wc -l") == ["0\n", "cat: missing: No such file or directory\n", 0]
  expect acceptSh(os, "cat missing 2>&1 | wc -l") == ["1\n", "", 0]
  expect acceptSh(os, "echo x | false") == ["", "", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "false | echo y") == ["y\n", "", 0]
  expect acceptSh(os, "echo b a | tr ' ' '\\n' | sort") == ["a\nb\n", "", 0]
}

test "sh and source run a file in this session" {
  var os = boot()
  expect acceptSh(os, "echo 'echo from script; X=7' > s.sh") == ["", "", 0]
  expect acceptSh(os, "echo \"cd /tmp\" >> s.sh") == ["", "", 0]
  expect acceptSh(os, "sh s.sh") == ["from script\n", "", 0]
  expect acceptSh(os, "echo $X") == ["7\n", "", 0]
  expect acceptSh(os, "pwd") == ["/tmp\n", "", 0]
  expect acceptSh(os, "cd") == ["", "", 0]
  expect acceptSh(os, "X=") == ["", "", 0]
  expect acceptSh(os, "source s.sh") == ["from script\n", "", 0]
  expect acceptSh(os, "echo $X") == ["7\n", "", 0]
  expect acceptSh(os, "sh missing") == ["", "sh: missing: No such file or directory\n", 1]
  expect acceptSh(os, "echo 'echo \"bad' > bad.sh") == ["", "", 0]
  expect acceptSyntax(os, "sh bad.sh")
  expect acceptSh(os, "echo $?") == ["2\n", "", 0]
}

test "env, export and unset" {
  var os = boot()
  expect acceptSh(os, "env") == ["HOME=/home/user\nPWD=/home/user\nUSER=user\n", "", 0]
  expect acceptSh(os, "export A=1 Z=2") == ["", "", 0]
  expect acceptSh(os, "B=x") == ["", "", 0]
  expect acceptSh(os, "env") == ["A=1\nB=x\nHOME=/home/user\nPWD=/home/user\nUSER=user\nZ=2\n", "", 0]
  expect acceptSh(os, "unset A Z B") == ["", "", 0]
  expect acceptSh(os, "export B") == ["", "", 0]
  expect acceptSh(os, "env") == ["HOME=/home/user\nPWD=/home/user\nUSER=user\n", "", 0]
  expect acceptSh(os, "echo [$A]") == ["[]\n", "", 0]
}

test "test" {
  var os = boot()
  expect acceptSh(os, "test a = a") == ["", "", 0]
  expect acceptSh(os, "test a = b") == ["", "", 1]
  expect acceptSh(os, "test a != b") == ["", "", 0]
  expect acceptSh(os, "test 3 -lt 10") == ["", "", 0]
  expect acceptSh(os, "test 10 -lt 3") == ["", "", 1]
  expect acceptSh(os, "test -5 -le -5") == ["", "", 0]
  expect acceptSh(os, "test 2 -gt 1") == ["", "", 0]
  expect acceptSh(os, "test 2 -ge 3") == ["", "", 1]
  expect acceptSh(os, "test 1 -eq 1") == ["", "", 0]
  expect acceptSh(os, "test 1 -ne 1") == ["", "", 1]
  expect acceptSh(os, "test -z \"\"") == ["", "", 0]
  expect acceptSh(os, "test -n \"\"") == ["", "", 1]
  expect acceptSh(os, "test -z x") == ["", "", 1]
  expect acceptSh(os, "test x") == ["", "", 0]
  expect acceptSh(os, "test \"\"") == ["", "", 1]
  expect acceptSh(os, "test") == ["", "", 1]
  expect acceptSh(os, "touch f") == ["", "", 0]
  expect acceptSh(os, "mkdir d") == ["", "", 0]
  expect acceptSh(os, "test -e f") == ["", "", 0]
  expect acceptSh(os, "test -f f") == ["", "", 0]
  expect acceptSh(os, "test -d f") == ["", "", 1]
  expect acceptSh(os, "test -d d") == ["", "", 0]
  expect acceptSh(os, "test -e nope") == ["", "", 1]
  expect acceptSh(os, "test ! -e nope") == ["", "", 0]
  expect acceptSh(os, "test ! a = a") == ["", "", 1]
  expect acceptSh(os, "test a -lt 3") == ["", "test: a: integer expression expected\n", 2]
  expect acceptSh(os, "[ a = a ]") == ["", "", 0]
  expect acceptSh(os, "[ a = b ]") == ["", "", 1]
  expect acceptSh(os, "[ a = a") == ["", "[: missing ]\n", 2]
  expect acceptSh(os, "[ ]") == ["", "", 1]
  expect acceptSh(os, "if [ -f f ] && [ ! -d f ]; then echo file; fi") == ["file\n", "", 0]
}

test "small commands" {
  var os = boot()
  expect acceptSh(os, "whoami") == ["user\n", "", 0]
  expect acceptSh(os, "uname") == ["fwebos\n", "", 0]
  expect acceptSh(os, "true") == ["", "", 0]
  expect acceptSh(os, "false") == ["", "", 1]
  expect acceptSh(os, "echo $?") == ["1\n", "", 0]
  expect acceptSh(os, "pwd | wc -c") == ["11\n", "", 0]
}
