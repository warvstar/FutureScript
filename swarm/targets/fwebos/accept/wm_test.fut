// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/os.fut"

fn acceptWins(os) {
  var r = []
  for w in wmList(os) { r.push([w.id, w.app, w.title, w.x, w.y, w.w, w.h, w.focused, w.minimized, w.maximized]) }
  return r
}

test "windows open in a cascade, focused" {
  var os = boot()
  expect wmOpen(os, "term", "Terminal") == 1
  expect wmOpen(os, "files", "Files") == 2
  expect wmOpen(os, "edit", "notes.txt") == 3
  expect acceptWins(os) == [[1, "term", "Terminal", 0, 0, 640, 400, false, false, false], [2, "files", "Files", 40, 30, 640, 400, false, false, false], [3, "edit", "notes.txt", 80, 60, 640, 400, true, false, false]]
}

test "the cascade wraps after eight" {
  var os = boot()
  expect wmOpen(os, "a", "0") == 1
  expect wmOpen(os, "a", "1") == 2
  expect wmOpen(os, "a", "2") == 3
  expect wmOpen(os, "a", "3") == 4
  expect wmOpen(os, "a", "4") == 5
  expect wmOpen(os, "a", "5") == 6
  expect wmOpen(os, "a", "6") == 7
  expect wmOpen(os, "a", "7") == 8
  expect wmOpen(os, "a", "8") == 9
  expect wmOpen(os, "a", "9") == 10
  expect acceptWins(os) == [[1, "a", "0", 0, 0, 640, 400, false, false, false], [2, "a", "1", 40, 30, 640, 400, false, false, false], [3, "a", "2", 80, 60, 640, 400, false, false, false], [4, "a", "3", 120, 90, 640, 400, false, false, false], [5, "a", "4", 160, 120, 640, 400, false, false, false], [6, "a", "5", 200, 150, 640, 400, false, false, false], [7, "a", "6", 240, 180, 640, 400, false, false, false], [8, "a", "7", 280, 210, 640, 400, false, false, false], [9, "a", "8", 0, 0, 640, 400, false, false, false], [10, "a", "9", 40, 30, 640, 400, true, false, false]]
}

test "focus raises" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  wmFocus(os, 1)
  expect acceptWins(os) == [[2, "b", "B", 40, 30, 640, 400, false, false, false], [3, "c", "C", 80, 60, 640, 400, false, false, false], [1, "a", "A", 0, 0, 640, 400, true, false, false]]
}

test "close" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  wmClose(os, 3)
  wmClose(os, 1)
  expect wmOpen(os, "d", "D") == 4
  expect acceptWins(os) == [[2, "b", "B", 40, 30, 640, 400, false, false, false], [4, "d", "D", 120, 90, 640, 400, true, false, false]]
}

test "move is clamped" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  wmMove(os, 1, -1000, -50)
  expect wmOpen(os, "b", "B") == 2
  wmMove(os, 2, 5000, 5000)
  expect wmOpen(os, "c", "C") == 3
  wmMove(os, 3, 100, 200)
  expect acceptWins(os) == [[1, "a", "A", -600, 0, 640, 400, false, false, false], [2, "b", "B", 1240, 776, 640, 400, false, false, false], [3, "c", "C", 100, 200, 640, 400, true, false, false]]
}

test "resize has a minimum" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  wmResize(os, 1, 50, 20)
  expect wmOpen(os, "b", "B") == 2
  wmResize(os, 2, 800, 600)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 160, 100, false, false, false], [2, "b", "B", 40, 30, 800, 600, true, false, false]]
}

test "minimize moves the focus" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  wmMinimize(os, 3)
  wmMinimize(os, 2)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 640, 400, true, false, false], [2, "b", "B", 40, 30, 640, 400, false, true, false], [3, "c", "C", 80, 60, 640, 400, false, true, false]]
}

test "focus restores a minimized window" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  wmMinimize(os, 1)
  wmFocus(os, 1)
  expect acceptWins(os) == [[2, "b", "B", 40, 30, 640, 400, false, false, false], [1, "a", "A", 0, 0, 640, 400, true, false, false]]
}

test "everything minimized: nothing focused" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  wmMinimize(os, 1)
  wmMinimize(os, 2)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 640, 400, false, true, false], [2, "b", "B", 40, 30, 640, 400, false, true, false]]
}

test "maximize toggles" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  wmMove(os, 2, 300, 200)
  wmMaximize(os, 2)
  wmMaximize(os, 2)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 640, 400, false, false, false], [2, "b", "B", 300, 200, 640, 400, true, false, false]]
}

test "moving a maximized window un-maximizes it" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  wmMaximize(os, 1)
  wmMove(os, 1, 10, 10)
  wmMaximize(os, 1)
  wmResize(os, 1, 300, 300)
  wmMaximize(os, 1)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 1280, 800, true, false, true]]
}

test "tile three" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  wmFocus(os, 1)
  wmTile(os)
  expect acceptWins(os) == [[2, "b", "B", 640, 0, 640, 400, false, false, false], [3, "c", "C", 0, 400, 640, 400, false, false, false], [1, "a", "A", 0, 0, 640, 400, true, false, false]]
}

test "tile five, skipping minimized" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  expect wmOpen(os, "d", "D") == 4
  expect wmOpen(os, "e", "E") == 5
  expect wmOpen(os, "f", "F") == 6
  wmMinimize(os, 2)
  wmMaximize(os, 6)
  wmTile(os)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 426, 400, false, false, false], [2, "b", "B", 40, 30, 640, 400, false, true, false], [3, "c", "C", 426, 0, 426, 400, false, false, false], [4, "d", "D", 852, 0, 426, 400, false, false, false], [5, "e", "E", 0, 400, 426, 400, false, false, false], [6, "f", "F", 426, 400, 426, 400, true, false, false]]
}

test "tile one and four" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  wmTile(os)
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  expect wmOpen(os, "d", "D") == 4
  wmTile(os)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 640, 400, false, false, false], [2, "b", "B", 640, 0, 640, 400, false, false, false], [3, "c", "C", 0, 400, 640, 400, false, false, false], [4, "d", "D", 640, 400, 640, 400, true, false, false]]
}

test "cycle" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  wmCycle(os)
  wmCycle(os)
  expect acceptWins(os) == [[2, "b", "B", 40, 30, 640, 400, false, false, false], [3, "c", "C", 80, 60, 640, 400, false, false, false], [1, "a", "A", 0, 0, 640, 400, true, false, false]]
}

test "cycle skips minimized windows" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmOpen(os, "c", "C") == 3
  wmMinimize(os, 3)
  wmCycle(os)
  expect acceptWins(os) == [[2, "b", "B", 40, 30, 640, 400, false, false, false], [1, "a", "A", 0, 0, 640, 400, true, false, false], [3, "c", "C", 80, 60, 640, 400, false, true, false]]
}

test "cycle with one window" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  wmMinimize(os, 1)
  wmCycle(os)
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 640, 400, false, true, false], [2, "b", "B", 40, 30, 640, 400, true, false, false]]
}

test "hit testing" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  expect wmOpen(os, "b", "B") == 2
  expect wmAt(os, 10, 10) == 1
  expect wmAt(os, 50, 40) == 2
  expect wmAt(os, 679, 429) == 2
  expect wmAt(os, 680, 430) == nil
  expect wmAt(os, 1000, 700) == nil
  wmMinimize(os, 2)
  expect wmAt(os, 50, 40) == 1
  expect wmAt(os, 39, 29) == 1
  expect acceptWins(os) == [[1, "a", "A", 0, 0, 640, 400, true, false, false], [2, "b", "B", 40, 30, 640, 400, false, true, false]]
}

test "unknown ids do nothing" {
  var os = boot()
  expect wmOpen(os, "a", "A") == 1
  wmClose(os, 7)
  wmFocus(os, 7)
  wmMove(os, 7, 1, 1)
  wmResize(os, 7, 1, 1)
  wmMinimize(os, 7)
  wmMaximize(os, 7)
  wmClose(os, 1)
  expect wmOpen(os, "b", "B") == 2
  expect acceptWins(os) == [[2, "b", "B", 40, 30, 640, 400, true, false, false]]
}
