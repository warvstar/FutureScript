// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/browser.fut"

test "initial values" {
  var h = "<p>x</p>"
  expect computedStyle(h, "p", "color") == "black"
  expect computedStyle(h, "p", "font-size") == "16px"
  expect computedStyle(h, "p", "margin-top") == "0px"
  expect computedStyle(h, "p", "width") == "auto"
  expect computedStyle(h, "p", "background-color") == "transparent"
  expect computedStyle(h, "p", "text-align") == "left"
  expect computedStyle(h, "p", "border-left-width") == "0px"
}

test "the default stylesheet" {
  var h = "<head><title>x</title></head><h1>a <span>b</span></h1><ul><li>c</li></ul><p><em>d</em></p>"
  expect computedStyle(h, "title", "display") == "none"
  expect computedStyle(h, "h1", "display") == "block"
  expect computedStyle(h, "span", "display") == "inline"
  expect computedStyle(h, "li", "display") == "list-item"
  expect computedStyle(h, "h1", "font-weight") == "bold"
  expect computedStyle(h, "span", "font-weight") == "bold"
  expect computedStyle(h, "em", "font-style") == "italic"
  expect computedStyle(h, "h1", "font-size") == "32px"
}

test "a type selector" {
  var h = "<style>p \{ color: red }</style><p>x</p>"
  expect computedStyle(h, "p", "color") == "red"
}

test "specificity" {
  var h = "<style>#a \{ color: green } .c \{ color: blue } p \{ color: red }</style><p id=\"a\" class=\"c\">x</p><p class=\"c\">y</p><p>z</p>"
  expect computedStyle(h, "#a", "color") == "green"
  expect computedStyle(h, "p.c:not(#a)", "color") == "blue"
  expect computedStyle(h, "p:not(.c)", "color") == "red"
}

test "specificity adds up over the compounds" {
  var h = "<style>div p \{ color: red } p.c \{ color: blue } div > p.c \{ color: green }</style><div><p class=\"c\">x</p></div>"
  expect computedStyle(h, "p", "color") == "green"
}

test "the later rule wins a tie" {
  var h = "<style>p \{ color: red } p \{ color: blue } p \{ margin-top: 1px; margin-top: 2px }</style><p>x</p>"
  expect computedStyle(h, "p", "color") == "blue"
  expect computedStyle(h, "p", "margin-top") == "2px"
}

test "!important beats specificity" {
  var h = "<style>p \{ color: red !important } #a \{ color: blue } p \{ font-weight: bold ! important } #a \{ font-weight: normal }</style><p id=\"a\">x</p>"
  expect computedStyle(h, "p", "color") == "red"
  expect computedStyle(h, "p", "font-weight") == "bold"
}

test "inline styles" {
  var h = "<style>#a \{ color: blue } #b \{ color: blue !important } #c \{ color: blue !important }</style><p id=\"a\" style=\"color: purple\">x</p><p id=\"b\" style=\"color: purple\">y</p><p id=\"c\" style=\"color: purple !important\">z</p>"
  expect computedStyle(h, "#a", "color") == "purple"
  expect computedStyle(h, "#b", "color") == "blue"
  expect computedStyle(h, "#c", "color") == "purple"
}

test "a selector list counts its most specific matching selector" {
  var h = "<style>#a, p \{ color: red } .c \{ color: blue }</style><p id=\"a\" class=\"c\">x</p><p class=\"c\">y</p>"
  expect computedStyle(h, "#a", "color") == "red"
  expect computedStyle(h, "p:last-child", "color") == "blue"
}

test "inherited and not inherited" {
  var h = "<style>div \{ color: red; font-weight: bold; margin-top: 5px; text-align: center }</style><div><p>x</p></div>"
  expect computedStyle(h, "p", "color") == "red"
  expect computedStyle(h, "p", "font-weight") == "bold"
  expect computedStyle(h, "p", "margin-top") == "0px"
  expect computedStyle(h, "p", "text-align") == "center"
  expect computedStyle(h, "div", "margin-top") == "5px"
}

test "inherit and initial" {
  var h = "<style>div \{ margin-left: 7px; color: red } p \{ margin-left: inherit; color: initial }</style><div><p>x</p></div>"
  expect computedStyle(h, "p", "margin-left") == "7px"
  expect computedStyle(h, "p", "color") == "black"
}

test "font-size in em and percent" {
  var h = "<style>div \{ font-size: 20px } p \{ font-size: 1.5em } span \{ font-size: 50% }</style><div><p>a<span>b</span></p></div><section style=\"font-size: 10px\"><h1>x</h1><h2>y</h2></section>"
  expect computedStyle(h, "div", "font-size") == "20px"
  expect computedStyle(h, "p", "font-size") == "30px"
  expect computedStyle(h, "span", "font-size") == "15px"
  expect computedStyle(h, "h1", "font-size") == "20px"
  expect computedStyle(h, "h2", "font-size") == "15px"
}

test "em lengths use the element's own font size" {
  var h = "<style>p \{ font-size: 20px; margin-top: 2em; padding-left: 0; width: 50% }</style><p>x</p>"
  expect computedStyle(h, "p", "margin-top") == "40px"
  expect computedStyle(h, "p", "padding-left") == "0px"
  expect computedStyle(h, "p", "width") == "50%"
}

test "shorthands" {
  var h = "<style>p \{ margin: 1px 2px 3px; padding: 4px 5px; border: solid 3px red } div \{ margin: 9px; border-width: 1px 2px 3px 4px }</style><p>x</p><div>y</div>"
  expect computedStyle(h, "p", "margin-top") == "1px"
  expect computedStyle(h, "p", "margin-right") == "2px"
  expect computedStyle(h, "p", "margin-bottom") == "3px"
  expect computedStyle(h, "p", "margin-left") == "2px"
  expect computedStyle(h, "p", "padding-top") == "4px"
  expect computedStyle(h, "p", "padding-left") == "5px"
  expect computedStyle(h, "p", "border-left-width") == "3px"
  expect computedStyle(h, "p", "margin") == nil
  expect computedStyle(h, "div", "margin-left") == "9px"
  expect computedStyle(h, "div", "border-top-width") == "1px"
  expect computedStyle(h, "div", "border-left-width") == "4px"
}

test "comments and at-rules are skipped" {
  var h = "<style>/* p \{ color: red } */ @import \"x.css\"; @media screen \{ p \{ color: blue } } p \{ color: green }</style><p>x</p>"
  expect computedStyle(h, "p", "color") == "green"
}

test "an invalid selector drops its whole rule" {
  var h = "<style>p:hover \{ color: red } p:hover, p \{ color: red } p \{ font-weight: bold }</style><p>x</p>"
  expect computedStyle(h, "p", "color") == "black"
  expect computedStyle(h, "p", "font-weight") == "bold"
}

test "style elements apply in document order, wherever they are" {
  var h = "<style>p \{ color: red }</style><p>x</p><div><style>p \{ color: blue }</style></div>"
  expect computedStyle(h, "p", "color") == "blue"
}

test "names and values are lowercased, spaces collapsed" {
  var h = "<style>p \{ COLOR: RED; Font-Family:  Times   New Roman ; margin-top: 3PX }</style><p>x</p>"
  expect computedStyle(h, "p", "color") == "red"
  expect computedStyle(h, "p", "font-family") == "times new roman"
  expect computedStyle(h, "p", "margin-top") == "3px"
}

test "combinators in the cascade" {
  var h = "<style>div p \{ color: red } div > p \{ color: blue } p + p \{ font-weight: bold }</style><div><section><p id=x>a</p></section><p id=y>b</p><p id=z>c</p></div>"
  expect computedStyle(h, "#x", "color") == "red"
  expect computedStyle(h, "#y", "color") == "blue"
  expect computedStyle(h, "#y", "font-weight") == "normal"
  expect computedStyle(h, "#z", "font-weight") == "bold"
}

test "no element, or a property nobody set" {
  var h = "<style>p \{ foo: bar }</style><p>x</p>"
  expect computedStyle(h, "div", "color") == nil
  expect computedStyle(h, "p", "foo") == "bar"
  expect computedStyle(h, "p", "baz") == nil
}

test "line-height" {
  var h = "<style>p \{ font-size: 20px; line-height: 1.5 } span \{ font-size: 10px } div \{ line-height: 2em; font-size: 10px }</style><p>a<span>b</span></p><div>c</div>"
  expect computedStyle(h, "p", "line-height") == "1.5"
  expect computedStyle(h, "span", "line-height") == "1.5"
  expect computedStyle(h, "div", "line-height") == "20px"
  expect computedStyle(h, "body", "line-height") == nil
}

test "an unsupported font-size is ignored" {
  var h = "<style>div \{ font-size: 20px } p \{ font-size: large }</style><div><p>x</p></div>"
  expect computedStyle(h, "p", "font-size") == "20px"
}

test "display: none doesn't change the children's display" {
  var h = "<div style=\"display:none\"><p>x</p></div>"
  expect computedStyle(h, "div", "display") == "none"
  expect computedStyle(h, "p", "display") == "block"
}
