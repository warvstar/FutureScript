// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/browser.fut"

test "paragraphs" {
  expect renderText("<h1>Title</h1><p>Hello <b>world</b>.</p>", 40) == ["Title", "Hello world."]
}

test "wrapping" {
  expect renderText("<p>the quick brown fox jumps</p>", 10) == ["the quick", "brown fox", "jumps"]
  expect renderText("<p>unbelievable day</p>", 9) == ["unbelievable", "day"]
}

test "br, and no empty lines" {
  expect renderText("<p>a<br>b<br><br>c</p><p></p><div> </div>", 20) == ["a", "b", "c"]
}

test "lists" {
  expect renderText("<ul><li>one</li><li>two words here</li></ul>", 10) == ["* one", "* two", "  words", "  here"]
}

test "nested lists" {
  expect renderText("<ul><li>a<ul><li>b</li></ul></li><li>c</li></ul>", 20) == ["* a", "  * b", "* c"]
  expect renderText("<ol><li><p>x</p><p>y</p></li></ol>", 20) == ["* x", "  y"]
}

test "hidden elements" {
  expect renderText("<head><title>T</title></head><p>a<span style=\"display:none\">b</span>c</p><script>x()</script>", 20) == ["ac"]
}

test "display from CSS" {
  expect renderText("<style>.blk \{ display: block } p \{ display: inline }</style><p>a</p> <p>b</p><span class=\"blk\">c</span>", 20) == ["a b", "c"]
}

test "text-transform" {
  expect renderText("<p style=\"text-transform: uppercase\">Hi <span style=\"text-transform: none\">there</span> <b>you</b></p>", 20) == ["HI there YOU"]
}

test "text-align" {
  expect renderText("<p style=\"text-align: center\">abc</p><p style=\"text-align: right\">ab</p><div style=\"text-align: center\"><p>abcd</p></div>", 9) == ["   abc", "       ab", "  abcd"]
}

test "hr" {
  expect renderText("<p>a</p><hr><p>b</p>", 5) == ["a", "-----", "b"]
}

test "pre" {
  expect renderText("<pre>\nline 1\n  line  2\n</pre><p>x  y</p>", 20) == ["line 1", "  line  2", "x y"]
  expect renderText("<pre>a\n\nb</pre>", 20) == ["a", "", "b"]
}

test "img alt" {
  expect renderText("<p>see <img src=\"x.png\" alt=\"logo\"> here <img src=\"y.png\"></p>", 30) == ["see [logo] here"]
}

test "inline text between blocks" {
  expect renderText("<div>a<div>b</div>c</div>", 20) == ["a", "b", "c"]
}

test "entities come out decoded" {
  expect renderText("<p>a &lt; b &amp;&amp; c</p>", 20) == ["a < b && c"]
}

test "words join across inline elements" {
  expect renderText("<p>un<b>believ</b>able day</p>", 9) == ["unbelievable", "day"]
}

test "a whole page" {
  expect renderText("<html><head><title>T</title><style>h1 \{ text-align: center } .note \{ text-transform: uppercase }</style></head><body><h1>Fut</h1><p>A <a href=\"/x\">small</a> page.</p><ul><li>one</li><li class=\"note\">two</li></ul><hr></body></html>", 12) == ["    Fut", "A small", "page.", "* one", "* TWO", "------------"]
}
