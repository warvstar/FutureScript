import "../src/browser.fut"

fn acceptIds(l) {
  var r = []
  for e in l { r.push(e.attrs.id) }
  return r
}
fn acceptDoc() { return parseHtml("<div id=\"root\" class=\"page\">\n  <header id=\"h\"><h1 id=\"t\" class=\"title big\">Title</h1><nav id=\"n\"><a id=\"a1\" href=\"/x\">x</a><a id=\"a2\" href=\"https://e.com\" class=\"ext\">e</a></nav></header>\n  <ul id=\"list\"><li id=\"l1\" class=\"item\">one</li><li id=\"l2\" class=\"item odd\">two</li><li id=\"l3\" class=\"item\">three</li></ul>\n  <p id=\"p1\">para <span id=\"s1\" lang=\"en-us\">s</span></p>\n  <p id=\"p2\" data-k=\"a b c\"><span id=\"s2\">t</span><em id=\"e1\">u</em></p>\n  <form id=\"f\"><input id=\"i1\" type=\"text\" name=\"q\"><input id=\"i2\" type=\"checkbox\" checked></form>\n</div>") }

test "type selectors" {
  var d = acceptDoc()
  expect acceptIds(querySelectorAll(d, "li")) == ["l1", "l2", "l3"]
  expect acceptIds(querySelectorAll(d, "LI")) == ["l1", "l2", "l3"]
  expect acceptIds(querySelectorAll(d, "table")) == []
}

test "universal selector" {
  var d = acceptDoc()
  expect acceptIds(querySelectorAll(d, "nav *")) == ["a1", "a2"]
  expect acceptIds(querySelectorAll(d, "#n > *")) == ["a1", "a2"]
}

