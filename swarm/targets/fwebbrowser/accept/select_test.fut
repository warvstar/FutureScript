  var d = acceptDoc()
  expect acceptIds(querySelectorAll(d, "[checked]")) == ["i2"]
  expect acceptIds(querySelectorAll(d, "[href]")) == ["a1", "a2"]
  expect acceptIds(querySelectorAll(d, "[HREF]")) == ["a1", "a2"]
}

test "attribute equals" {
  var d = acceptDoc()
  expect acceptIds(querySelectorAll(d, "input[type=text]")) == ["i1"]
  expect acceptIds(querySelectorAll(d, "[type=\"checkbox\"]")) == ["i2"]
  expect acceptIds(querySelectorAll(d, "[type='radio']")) == []
}

test "attribute operators" {
  var d = acceptDoc()
  expect acceptIds(querySelectorAll(d, "[href^=\"https\"]")) == ["a2"]
  expect acceptIds(querySelectorAll(d, "[href$=x]")) == ["a1"]
  expect acceptIds(querySelectorAll(d, "[data-k~=b]")) == ["p2"]
  expect acceptIds(querySelectorAll(d, "[lang*=us]")) == ["s1"]
  expect acceptIds(querySelectorAll(d, "[data-k~=\"a b\"]")) == []
