// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/browser.fut"

fn acceptBoxes(l) {
  var r = []
  for b in l { r.push([b.tag, b.x, b.y, b.width, b.height]) }
  return r
}

test "empty blocks" {
  expect acceptBoxes(layout("<div></div><p></p>", 800)) == [["div", 0, 0, 800, 0], ["p", 0, 0, 800, 0]]
}

test "a line of text" {
  expect acceptBoxes(layout("<p>hello world</p>", 800)) == [["p", 0, 0, 800, 20]]
  expect acceptBoxes(layout("hello", 800)) == []
}

test "blocks stack" {
  expect acceptBoxes(layout("<div>a</div><div>b</div>", 800)) == [["div", 0, 0, 800, 20], ["div", 0, 20, 800, 20]]
}

test "text wraps at the width" {
  expect acceptBoxes(layout("<p>aaaa bbbb cccc</p>", 80)) == [["p", 0, 0, 80, 40]]
  expect acceptBoxes(layout("<p>abcdefghijklmnop q</p>", 80)) == [["p", 0, 0, 80, 40]]
  expect acceptBoxes(layout("<p>aaaa bbbbb</p>", 80)) == [["p", 0, 0, 80, 20]]
}

test "margins, borders and padding" {
  expect acceptBoxes(layout("<style>div \{ margin: 10px 20px; padding: 5px; border: 2px solid }</style><div>x</div>", 800)) == [["div", 20, 10, 760, 34]]
}

test "margins don't collapse" {
  expect acceptBoxes(layout("<style>p \{ margin: 10px 0 }</style><p>a</p><p>b</p>", 800)) == [["p", 0, 10, 800, 20], ["p", 0, 50, 800, 20]]
}

test "nested blocks" {
  expect acceptBoxes(layout("<div style=\"padding: 10px\"><p style=\"margin-left: 30px\">a</p></div>", 400)) == [["div", 0, 0, 400, 40], ["p", 40, 10, 350, 20]]
}

test "width and height" {
  expect acceptBoxes(layout("<div style=\"width: 200px; height: 50px; padding: 5px\">a b c</div>", 800)) == [["div", 0, 0, 210, 60]]
  expect acceptBoxes(layout("<div style=\"width: 50%\">x</div>", 600)) == [["div", 0, 0, 300, 20]]
  expect acceptBoxes(layout("<div style=\"width: 40px\">aaa bbb</div>", 600)) == [["div", 0, 0, 40, 40]]
}

test "font size changes the lines" {
  expect acceptBoxes(layout("<h1>Big title here</h1>", 160)) == [["h1", 0, 0, 160, 80]]
  expect acceptBoxes(layout("<p style=\"font-size: 8px\">aaaa bbbb cccc</p>", 40)) == [["p", 0, 0, 40, 20]]
}

test "line-height" {
  expect acceptBoxes(layout("<p style=\"line-height: 30px\">a<br>b</p>", 800)) == [["p", 0, 0, 800, 60]]
  expect acceptBoxes(layout("<p style=\"line-height: 2\">a</p>", 800)) == [["p", 0, 0, 800, 32]]
}

test "inline elements flow with the text" {
  expect acceptBoxes(layout("<p>aaa <b>bbb</b> <span>ccc</span></p>", 64)) == [["p", 0, 0, 64, 40]]
}

test "display: none takes no space" {
  expect acceptBoxes(layout("<div>a</div><div style=\"display:none\">b</div><div>c</div>", 800)) == [["div", 0, 0, 800, 20], ["div", 0, 20, 800, 20]]
  expect acceptBoxes(layout("<p>a<span style=\"display: none\">hidden words here</span></p>", 16)) == [["p", 0, 0, 16, 20]]
}

test "inline text between blocks" {
  expect acceptBoxes(layout("<div>a<p>b</p>c</div>", 800)) == [["div", 0, 0, 800, 60], ["p", 0, 20, 800, 20]]
}

test "head is not laid out" {
  expect acceptBoxes(layout("<html><head><title>T</title><style>p \{ margin-top: 4px }</style></head><body><p>x</p></body></html>", 800)) == [["html", 0, 0, 800, 24], ["body", 0, 0, 800, 24], ["p", 0, 4, 800, 20]]
}

test "list items are blocks" {
  expect acceptBoxes(layout("<ul><li>a</li><li>b</li></ul>", 800)) == [["ul", 0, 0, 800, 40], ["li", 0, 0, 800, 20], ["li", 0, 20, 800, 20]]
}

test "whitespace collapses" {
  expect acceptBoxes(layout("<p>   a  \n  b   </p>", 24)) == [["p", 0, 0, 24, 20]]
}

test "img alt is text" {
  expect acceptBoxes(layout("<p>a <img alt=\"pic\"> b</p>", 40)) == [["p", 0, 0, 40, 60]]
}

test "pre lines" {
  expect acceptBoxes(layout("<pre>a\n\nb c d e f g h</pre>", 16)) == [["pre", 0, 0, 16, 60]]
}
