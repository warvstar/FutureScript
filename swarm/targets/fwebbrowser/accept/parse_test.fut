// generated by gen.py from its reference implementation of the spec; do not edit
import "../src/browser.fut"

test "elements and text" {
  var d = parseHtml("<div><p>Hello <b>world</b></p></div>")
  expect serialize(d) == "<div><p>Hello <b>world</b></p></div>"
}

test "tag and attribute names are lowercased" {
  var d = parseHtml("<DIV ID=\"a\" Class=\"b\">x</DIV>")
  expect serialize(d) == "<div id=\"a\" class=\"b\">x</div>"
}

test "attribute quoting styles" {
  var d = parseHtml("<a href='x y' title=\"q\" data-n=5 hidden>z</a>")
  expect serialize(d) == "<a href=\"x y\" title=\"q\" data-n=\"5\" hidden=\"\">z</a>"
  expect d.children[0].tag == "a"
  expect d.children[0].attrs == {"href": "x y", "title": "q", "data-n": "5", "hidden": ""}
  expect d.children[0].children[0].type == "text"
}

test "void elements have no children or end tag" {
  var d = parseHtml("<p>a<br>b<img src=\"i.png\">c</p>")
  expect serialize(d) == "<p>a<br>b<img src=\"i.png\">c</p>"
  expect d.children[0].children.len() == 5
  expect d.children[0].children[1].children == []
}

test "self-closing slash" {
  var d = parseHtml("<div><br/><span/>x</div>")
  expect serialize(d) == "<div><br><span></span>x</div>"
}

test "entities are decoded" {
  var d = parseHtml("<p title=\"&quot;hi&quot;\">a &amp; b &lt;c&gt; it&#39;s &copy;</p>")
  expect serialize(d) == "<p title=\"&quot;hi&quot;\">a &amp; b &lt;c&gt; it's &amp;copy;</p>"
  expect textContent(d) == "a & b <c> it's &copy;"
  expect d.children[0].attrs.title == "\"hi\""
}

test "comments and doctype are dropped" {
  var d = parseHtml("<!DOCTYPE html><p>a<!-- x -->b</p><!-- y -->")
  expect serialize(d) == "<p>ab</p>"
  expect d.children.len() == 1
  expect d.children[0].children.len() == 1
}

test "whitespace between elements is kept" {
  var d = parseHtml("<ul>\n  <li>a</li>\n  <li>b c</li>\n</ul>")
  expect serialize(d) == "<ul>\n  <li>a</li>\n  <li>b c</li>\n</ul>"
  expect d.children[0].children.len() == 5
  expect d.children[0].children[0].text == "\n  "
}

test "other text is kept as written" {
  var d = parseHtml("<p>  a   b  </p>")
  expect serialize(d) == "<p>  a   b  </p>"
  expect textContent(d) == "  a   b  "
}

test "p closes an open p" {
  var d = parseHtml("<p>one<p>two")
  expect serialize(d) == "<p>one</p><p>two</p>"
}

test "a block closes an open p" {
  var d = parseHtml("<p>one<div>two</div><p>three<hr>")
  expect serialize(d) == "<p>one</p><div>two</div><p>three</p><hr>"
}

test "li closes an open li" {
  var d = parseHtml("<ul><li>a<li>b<ul><li>c<li>d</ul><li>e</ul>")
  expect serialize(d) == "<ul><li>a</li><li>b<ul><li>c</li><li>d</li></ul></li><li>e</li></ul>"
}

test "table cells and rows close" {
  var d = parseHtml("<table><tr><td>1<td>2<tr><th>3</table>")
  expect serialize(d) == "<table><tr><td>1</td><td>2</td></tr><tr><th>3</th></tr></table>"
}

test "stray end tags are ignored, open elements closed at the end" {
  var d = parseHtml("<div>a</span>b<em>c</div>d")
  expect serialize(d) == "<div>ab<em>c</em></div>d"
}

test "an end tag closes the elements inside it" {
  var d = parseHtml("<div><b><i>x</div>y")
  expect serialize(d) == "<div><b><i>x</i></b></div>y"
}

test "script and style are raw text" {
  var d = parseHtml("<script>if (a < b && c) \{ x(\"</p>\") }</script><style>p > a \{ color: red }</style>")
  expect serialize(d) == "<script>if (a < b && c) \{ x(\"</p>\") }</script><style>p > a \{ color: red }</style>"
  expect d.children[0].children[0].text == "if (a < b && c) \{ x(\"</p>\") }"
}

test "pre keeps its whitespace, minus a leading newline" {
  var d = parseHtml("<pre>\n  a\n\n  b\n</pre>")
  expect serialize(d) == "<pre>  a\n\n  b\n</pre>"
  expect textContent(d) == "  a\n\n  b\n"
}

test "a space between inline elements is a text node" {
  var d = parseHtml("<p><b>x</b> <i>y</i></p>")
  expect serialize(d) == "<p><b>x</b> <i>y</i></p>"
  expect d.children[0].children[1].text == " "
}

test "unquoted values may contain slashes" {
  var d = parseHtml("<a href=/x/y>z</a>")
  expect serialize(d) == "<a href=\"/x/y\">z</a>"
}

test "the first of a repeated attribute wins" {
  var d = parseHtml("<p id=a id=b>x</p>")
  expect serialize(d) == "<p id=\"a\">x</p>"
}

test "a lone < is text" {
  var d = parseHtml("a < b <p>c</p>")
  expect serialize(d) == "a &lt; b <p>c</p>"
}

test "node shapes" {
  var d = parseHtml("<div>a<p>b<b>c</b></p>d</div>")
  expect d.type == "document"
  var div = d.children[0]
  expect div.type == "element" && div.tag == "div" && div.attrs == {}
  expect div.children.len() == 3
  expect div.children[0].type == "text" && div.children[0].text == "a"
  expect div.children[1].tag == "p"
  expect textContent(div) == "abcd"
}
