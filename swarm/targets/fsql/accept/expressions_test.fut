import "../src/fsql.fut"

test "arithmetic and alias" {
  var r = runScript("SELECT 1 + 2 * 3 AS a, (1 + 2) * 3 AS b, 10 - 4 - 3 AS c;")
  expect r.len() == 1
  expect r[0].error == nil
  expect r[0].columns == ["a", "b", "c"]
  expect r[0].rows == [[7, 9, 3]]
}

test "integer division truncates" {
  var r = runScript("SELECT 7 / 2 AS a, -7 / 2 AS b, 7 % 3 AS c;")
  expect r.len() == 1
  expect r[0].error == nil
  expect r[0].columns == ["a", "b", "c"]
  expect r[0].rows == [[3, -3, 1]]
}

test "division by zero is NULL" {
  var r = runScript("SELECT 1 / 0 AS a;")
  expect r.len() == 1
  expect r[0].error == nil
  expect r[0].columns == ["a"]
  expect r[0].rows == [[nil]]
}

test "comparisons give 1 and 0" {
  var r = runScript("SELECT 1 < 2 AS a, 2 < 1 AS b, 'a' = 'a' AS c, 3 <> 3 AS d;")
  expect r.len() == 1
  expect r[0].error == nil
  expect r[0].columns == ["a", "b", "c", "d"]
  expect r[0].rows == [[1, 0, 1, 0]]
}

test "NULL arithmetic" {
  var r = runScript("SELECT 1 + NULL AS a, NULL = NULL AS b, NULL IS NULL AS c, 1 IS NOT NULL AS d;")
  expect r.len() == 1
  expect r[0].error == nil
  expect r[0].columns == ["a", "b", "c", "d"]
  expect r[0].rows == [[nil, nil, 1, 1]]
}

test "three-valued AND OR" {
  var r = runScript("SELECT NULL AND 0 AS a, NULL OR 1 AS b, NULL AND 1 AS c, NOT NULL AS d;")
  expect r.len() == 1
  expect r[0].error == nil
  expect r[0].columns == ["a", "b", "c", "d"]
  expect r[0].rows == [[0, 1, nil, nil]]
}

test "where filters NULL comparisons" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); SELECT id FROM t WHERE age > 20 ORDER BY id;")
  expect r.len() == 3
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[2].columns == ["id"]
  expect r[2].rows == [[1], [2], [4]]
}

