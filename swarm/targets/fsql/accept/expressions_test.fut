test "like" {
  var r = runScript("CREATE TABLE w (s TEXT); INSERT INTO w VALUES ('apple'), ('apply'), ('maple'), ('ape'); SELECT s FROM w WHERE s LIKE 'app%' ORDER BY s; SELECT s FROM w WHERE s LIKE '_pe' ORDER BY s;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[2].columns == ["s"]
  expect r[2].rows == [["apple"], ["apply"]]
  expect r[3].error == nil
  expect r[3].columns == ["s"]
  expect r[3].rows == [["ape"]]
}

test "and or not precedence" {
