test "inner join" {
  var r = runScript("CREATE TABLE u (id INT PRIMARY KEY, name TEXT); CREATE TABLE o (id INT PRIMARY KEY, uid INT, amt INT); INSERT INTO u VALUES (1, 'ann'), (2, 'bob'), (3, 'cy'); INSERT INTO o VALUES (10, 1, 5), (11, 1, 7), (12, 2, 3), (13, 9, 1); SELECT u.name, o.amt FROM u JOIN o ON o.uid = u.id ORDER BY o.id;")
  expect r.len() == 5
  expect r[0].error == nil
  expect r[1].error == nil
  expect r[2].changed == 3
  expect r[3].changed == 4
  expect r[4].error == nil
  expect r[4].columns == ["name", "amt"]
  expect r[4].rows == [["ann", 5], ["ann", 7], ["bob", 3]]
}

test "inner join keyword" {
