test "create and select empty" {
  var r = runScript("CREATE TABLE t (a INT); SELECT a FROM t;")
  expect r.len() == 2
  expect r[0].error == nil
  expect r[1].error == nil
  expect r[1].columns == ["a"]
  expect r[1].rows == []
}

test "insert counts rows" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'a', 2, 0.5), (2, 'b', 3, 1.5);")
  expect r.len() == 2
  expect r[0].error == nil
  expect r[1].changed == 2
}

test "select star" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); SELECT * FROM t ORDER BY id;")
  expect r.len() == 3
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[2].columns == ["id", "name", "age", "score"]
  expect r[2].rows == [[1, "ann", 30, 1.5], [2, "bob", 25, 2.5], [3, "cy", nil, 4.0], [4, "dee", 41, nil]]
}

