test "update counts and changes" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); UPDATE t SET age = age + 1 WHERE age > 26; SELECT id, age FROM t ORDER BY id;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].changed == 2
  expect r[3].error == nil
  expect r[3].columns == ["id", "age"]
  expect r[3].rows == [[1, 31], [2, 25], [3, nil], [4, 42]]
}

