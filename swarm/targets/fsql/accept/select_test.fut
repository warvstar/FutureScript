test "order by desc" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); SELECT id FROM t ORDER BY id DESC;")
  expect r.len() == 3
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[2].columns == ["id"]
  expect r[2].rows == [[4], [3], [2], [1]]
}

test "order by text then id" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); INSERT INTO t VALUES (5, 'ann', 1, 1.0); SELECT id FROM t ORDER BY name, id DESC;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].changed == 1
  expect r[3].error == nil
  expect r[3].columns == ["id"]
  expect r[3].rows == [[5], [1], [2], [3], [4]]
}

test "order by expression alias" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); SELECT id, score * 2 AS d FROM t WHERE score IS NOT NULL ORDER BY d DESC;")
