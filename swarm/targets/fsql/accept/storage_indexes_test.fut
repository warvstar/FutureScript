test "index follows updates" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); CREATE INDEX t_age ON t (age); UPDATE t SET age = 99 WHERE id = 1; SELECT id FROM t WHERE age = 99; SELECT id FROM t WHERE age = 30;")
  expect r.len() == 6
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[3].changed == 1
  expect r[4].error == nil
  expect r[4].columns == ["id"]
  expect r[4].rows == [[1]]
  expect r[5].error == nil
  expect r[5].columns == ["id"]
  expect r[5].rows == []
}

test "index follows deletes" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); CREATE INDEX t_name ON t (name); DELETE FROM t WHERE name = 'bob'; SELECT id FROM t WHERE name = 'bob';")
  expect r.len() == 5
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[3].changed == 1
  expect r[4].error == nil
  expect r[4].columns == ["id"]
  expect r[4].rows == []
}

test "drop index" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); CREATE INDEX t_age ON t (age); DROP INDEX t_age; SELECT id FROM t WHERE age = 41;")
  expect r.len() == 5
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[3].error == nil
  expect r[4].error == nil
  expect r[4].columns == ["id"]
  expect r[4].rows == [[4]]
}
