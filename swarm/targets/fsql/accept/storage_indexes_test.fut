test "create index" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); CREATE INDEX t_age ON t (age); SELECT id FROM t WHERE age = 25;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[3].error == nil
  expect r[3].columns == ["id"]
  expect r[3].rows == [[2]]
}

