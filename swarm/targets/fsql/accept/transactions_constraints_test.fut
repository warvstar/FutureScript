// generated by gen.py from SQLite; do not edit
import "../src/fsql.fut"

test "duplicate primary key is an error" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); INSERT INTO t VALUES (2, 'x', 1, 1.0); SELECT name FROM t WHERE id = 2;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error != nil
  expect r[3].error == nil
  expect r[3].columns == ["name"]
  expect r[3].rows == [["bob"]]
}

test "failed multi-row insert changes nothing" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); INSERT INTO t VALUES (9, 'x', 1, 1.0), (1, 'y', 1, 1.0); SELECT COUNT(*) AS n FROM t;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error != nil
  expect r[3].error == nil
  expect r[3].columns == ["n"]
  expect r[3].rows == [[4]]
}

test "not null is enforced" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); INSERT INTO t (id, age) VALUES (8, 3); SELECT COUNT(*) AS n FROM t;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error != nil
  expect r[3].error == nil
  expect r[3].columns == ["n"]
  expect r[3].rows == [[4]]
}

test "update to NULL in NOT NULL column fails" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); UPDATE t SET name = NULL WHERE id = 1; SELECT name FROM t WHERE id = 1;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error != nil
  expect r[3].error == nil
  expect r[3].columns == ["name"]
  expect r[3].rows == [["ann"]]
}

test "update making a duplicate key fails" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); UPDATE t SET id = 2 WHERE id = 1; SELECT id FROM t ORDER BY id;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error != nil
  expect r[3].error == nil
  expect r[3].columns == ["id"]
  expect r[3].rows == [[1], [2], [3], [4]]
}

test "rollback undoes" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); BEGIN; INSERT INTO t VALUES (9, 'z', 1, 1.0); DELETE FROM t WHERE id = 1; ROLLBACK; SELECT id FROM t ORDER BY id;")
  expect r.len() == 7
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[3].changed == 1
  expect r[4].changed == 1
  expect r[5].error == nil
  expect r[6].error == nil
  expect r[6].columns == ["id"]
  expect r[6].rows == [[1], [2], [3], [4]]
}

test "commit keeps" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); BEGIN; INSERT INTO t VALUES (9, 'z', 1, 1.0); COMMIT; SELECT id FROM t ORDER BY id;")
  expect r.len() == 6
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[3].changed == 1
  expect r[4].error == nil
  expect r[5].error == nil
  expect r[5].columns == ["id"]
  expect r[5].rows == [[1], [2], [3], [4], [9]]
}

test "rollback undoes create" {
  var r = runScript("BEGIN; CREATE TABLE x (a INT); ROLLBACK; SELECT a FROM x;")
  expect r.len() == 4
  expect r[0].error == nil
  expect r[1].error == nil
  expect r[2].error == nil
  expect r[3].error != nil
}

test "an error inside a transaction keeps earlier work" {
  var r = runScript("CREATE TABLE t (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL); INSERT INTO t VALUES (1, 'ann', 30, 1.5), (2, 'bob', 25, 2.5), (3, 'cy', NULL, 4.0), (4, 'dee', 41, NULL); BEGIN; INSERT INTO t VALUES (9, 'z', 1, 1.0); INSERT INTO t VALUES (9, 'z', 1, 1.0); COMMIT; SELECT COUNT(*) AS n FROM t;")
  expect r.len() == 7
  expect r[0].error == nil
  expect r[1].changed == 4
  expect r[2].error == nil
  expect r[3].changed == 1
  expect r[4].error != nil
  expect r[5].error == nil
  expect r[6].error == nil
  expect r[6].columns == ["n"]
  expect r[6].rows == [[5]]
}
